@page "/book"
@rendermode InteractiveServer
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using System.Security.Claims
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IEmailSender EmailSender
@inject NavigationManager NavigationManager
@inject StripeCheckoutService StripeCheckout
@inject IOptions<StripeSettings> StripeSettings
@inject IJSRuntime JsRuntime

<PageTitle>Book an Appointment - Fargo Spa and Wellness</PageTitle>

<section class="catalog-header">
    <div class="container">
        <p class="eyebrow">Reserve Your Visit</p>
        <h1 class="section-title">Book Your Treatment</h1>
        <p class="catalog-subtitle">Complete the steps below to reserve your appointment.</p>
    </div>
</section>

<section class="services-section">
    <div class="container">
        <div class="booking-shell">
            @if (services is null)
            {
                <p>Loading...</p>
            }
            else
            {
                <div class="booking-stepper">
                    <div class="booking-step @StepClass(1)">
                        <span class="booking-step-badge">@(step > 1 ? "✓" : "1")</span> Service
                    </div>
                    <div class="booking-step-connector"></div>
                    <div class="booking-step @StepClass(2)">
                        <span class="booking-step-badge">@(step > 2 ? "✓" : "2")</span> Date &amp; Time
                    </div>
                    <div class="booking-step-connector"></div>
                    <div class="booking-step @StepClass(3)">
                        <span class="booking-step-badge">@(step > 3 ? "✓" : "3")</span> Review
                    </div>
                    <div class="booking-step-connector"></div>
                    <div class="booking-step @StepClass(4)">
                        <span class="booking-step-badge">4</span> Payment
                    </div>
                </div>

                <div class="auth-card">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }

                    @if (step == 1)
                    {
                        <h2 class="booking-card-title">Choose your treatment</h2>
                        <p class="booking-card-subtitle">Select the service you'd like to book.</p>

                        <div class="treatment-grid">
                            @foreach (var service in services)
                            {
                                <button type="button" class="treatment-option @(selectedServiceId == service.Id ? "selected" : "")"
                                        @onclick="() => SelectService(service.Id)">
                                    <div class="service-icon">@ServiceCategoryIcon.GetIcon(service.Category)</div>
                                    <p class="service-category">@service.Category</p>
                                    <h3 class="service-name">@service.Name</h3>
                                    <p class="service-description">@service.Description</p>
                                    <div class="service-meta">
                                        <span>@FormatDuration(service.DurationMinutes)</span>
                                        <span class="service-price">@service.Price.ToString("C")</span>
                                    </div>
                                </button>
                            }
                        </div>

                        <div class="booking-actions">
                            <span></span>
                            <button type="button" class="btn btn-spa-primary" disabled="@(selectedServiceId == 0)" @onclick="GoToStep2">
                                Continue &rarr;
                            </button>
                        </div>
                    }
                    else if (step == 2)
                    {
                        <h2 class="booking-card-title">Pick a date &amp; time</h2>
                        <p class="booking-card-subtitle">Business hours are 8:00 AM to 5:00 PM.</p>

                        <div class="booking-calendar-nav">
                            <button type="button" class="booking-calendar-nav-btn" disabled="@IsCurrentWeek" @onclick="GoToPreviousWeek">&lsaquo;</button>
                            <span class="booking-calendar-nav-title">@weekStart.ToString("MMMM yyyy")</span>
                            <button type="button" class="booking-calendar-nav-btn" @onclick="GoToNextWeek">&rsaquo;</button>
                        </div>

                        <div class="booking-week">
                            @foreach (var day in WeekDays())
                            {
                                <button type="button" class="booking-day @(selectedDate.Date == day.Date ? "selected" : "")"
                                        disabled="@(day.Date < ClinicClock.Today)"
                                        @onclick="() => SelectDate(day)">
                                    <span class="booking-day-label">@day.ToString("ddd").ToUpperInvariant()</span>
                                    <span class="booking-day-number">@day.Day</span>
                                </button>
                            }
                        </div>

                        @if (loadingSlots)
                        {
                            <p class="booking-slots-hint">Checking availability...</p>
                        }
                        else if (slots.Count == 0)
                        {
                            <p class="booking-slots-hint">No open slots for this date. Try another day.</p>
                        }
                        else
                        {
                            <div class="booking-slots">
                                @foreach (var slot in slots)
                                {
                                    <button type="button"
                                            class="booking-slot @(!slot.Available ? "unavailable" : "") @(selectedStart == slot.Start ? "selected" : "")"
                                            disabled="@(!slot.Available)"
                                            @onclick="() => SelectSlot(slot)">
                                        @slot.Start.ToString("h:mm tt")
                                        @if (slot.Available && slot == nextAvailableSlot)
                                        {
                                            <br /><span style="font-size:0.65rem;opacity:0.85;">Next available</span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        @if (providers.Count > 0)
                        {
                            <div class="admin-form-field booking-provider-field">
                                <label>Preferred provider (optional)</label>
                                <select class="admin-role-select" @bind="selectedProviderId" @bind:after="LoadSlotsAsync">
                                    <option value="0">No preference</option>
                                    @foreach (var provider in providers)
                                    {
                                        <option value="@provider.Id">@provider.FullName</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="booking-actions">
                            <button type="button" class="btn btn-spa-secondary" @onclick="GoToStep1">&larr; Back</button>
                            <button type="button" class="btn btn-spa-primary" disabled="@(selectedStart is null)" @onclick="GoToStep3">
                                Continue &rarr;
                            </button>
                        </div>
                    }
                    else if (step == 3 && selectedService is not null && selectedStart is not null)
                    {
                        <h2 class="booking-card-title">Review &amp; confirm</h2>
                        <p class="booking-card-subtitle">Please review your booking before paying.</p>

                        <div class="booking-review-table">
                            <div class="booking-review-row">
                                <span class="booking-review-label">Treatment</span>
                                <span class="booking-review-value">@selectedService.Name</span>
                            </div>
                            <div class="booking-review-row">
                                <span class="booking-review-label">Category</span>
                                <span class="booking-review-value">@selectedService.Category</span>
                            </div>
                            <div class="booking-review-row">
                                <span class="booking-review-label">Duration</span>
                                <span class="booking-review-value">@FormatDuration(selectedService.DurationMinutes)</span>
                            </div>
                            <div class="booking-review-row">
                                <span class="booking-review-label">Date</span>
                                <span class="booking-review-value">@selectedStart.Value.ToString("dddd, MMMM d")</span>
                            </div>
                            <div class="booking-review-row">
                                <span class="booking-review-label">Time</span>
                                <span class="booking-review-value">@selectedStart.Value.ToString("h:mm tt")</span>
                            </div>
                            @if (selectedProviderId != 0)
                            {
                                <div class="booking-review-row">
                                    <span class="booking-review-label">Provider</span>
                                    <span class="booking-review-value">@(providers.FirstOrDefault(p => p.Id == selectedProviderId)?.FullName ?? "No preference")</span>
                                </div>
                            }
                            <div class="booking-review-row total">
                                <span>Total</span>
                                <span>@selectedService.Price.ToString("C")</span>
                            </div>
                        </div>

                        @if (!isAuthenticated)
                        {
                            <div class="alert alert-warning mb-4" role="alert">
                                You must be signed in to complete your booking. Please <a href="@GetLoginUrl()" class="alert-link" data-enhance-nav="false">sign in</a> or <a href="@GetRegisterUrl()" class="alert-link" data-enhance-nav="false">create an account</a> to proceed.
                            </div>
                        }
                        else
                        {
                            <label class="booking-consent">
                                <input type="checkbox" @bind="consentGiven" />
                                <span>I agree to the cancellation policy and to receive booking notifications by email.</span>
                            </label>
                        }

                        <div class="booking-actions">
                            <button type="button" class="btn btn-spa-secondary" @onclick="GoToStep2">&larr; Back</button>
                            <button type="button" class="btn btn-spa-primary" disabled="@(!isAuthenticated || !consentGiven || creatingCheckout)" @onclick="HandleBooking">
                                @(creatingCheckout ? "Preparing payment..." : "Continue to Payment")
                            </button>
                        </div>
                    }
                    else if (step == 4 && awaitingPayment && selectedService is not null && selectedStart is not null)
                    {
                        <h2 class="booking-card-title">Payment</h2>

                        <div class="booking-test-card-hint">
                            <p class="booking-test-card-title">🧪 Sandbox test card - no real charge</p>
                            <div class="booking-test-card-grid">
                                <div>
                                    <span class="booking-test-card-label">Card number</span>
                                    <span class="booking-test-card-value">4242 4242 4242 4242</span>
                                </div>
                                <div>
                                    <span class="booking-test-card-label">Expiry</span>
                                    <span class="booking-test-card-value">Any future date (e.g. 12/34)</span>
                                </div>
                                <div>
                                    <span class="booking-test-card-label">CVC</span>
                                    <span class="booking-test-card-value">Any 3 digits</span>
                                </div>
                                <div>
                                    <span class="booking-test-card-label">ZIP / postal code</span>
                                    <span class="booking-test-card-value">Any valid code (e.g. 58102)</span>
                                </div>
                            </div>
                        </div>

                        <div id="stripe-checkout-container" class="booking-stripe-container"></div>

                        <div class="booking-actions">
                            <button type="button" class="btn btn-spa-secondary" @onclick="GoBackToReview">&larr; Back</button>
                            <span></span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "serviceId")]
    public int? ServiceId { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? Date { get; set; }

    [SupplyParameterFromQuery(Name = "time")]
    public string? Time { get; set; }

    private static readonly TimeSpan OpeningTime = TimeSpan.FromHours(8);
    private static readonly TimeSpan ClosingTime = TimeSpan.FromHours(17);
    private static readonly TimeSpan SlotInterval = TimeSpan.FromMinutes(30);

    private List<Service>? services;
    private List<User> providers = new();
    private int step = 1;
    private int selectedServiceId;
    private int selectedProviderId;
    private Service? selectedService;
    private DateTime weekStart = StartOfWeek(ClinicClock.Today);
    private DateTime selectedDate = ClinicClock.Today;
    private List<TimeSlot> slots = new();
    private TimeSlot? nextAvailableSlot;
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isAuthenticated;
    private DateTime? selectedStart;
    private bool consentGiven;
    private string? errorMessage;
    private bool loadingSlots;

    private bool creatingCheckout;
    private bool awaitingPayment;
    private string? checkoutClientSecret;
    private bool checkoutMounted;
    private IJSObjectReference? stripeModule;

    private bool IsCurrentWeek => weekStart.Date <= StartOfWeek(ClinicClock.Today);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        services = await db.Services.OrderBy(s => s.Category).ThenBy(s => s.Name).ToListAsync();
        providers = await db.Users.Where(u => u.Role == "Provider").OrderBy(u => u.LastName).ToListAsync();

        if (ServiceId.HasValue && services.Any(s => s.Id == ServiceId.Value))
        {
            SelectService(ServiceId.Value);

            if (!string.IsNullOrEmpty(Date) && DateTime.TryParseExact(Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsedDate))
            {
                selectedDate = parsedDate.Date;
                weekStart = StartOfWeek(selectedDate);
                await LoadSlotsAsync();

                if (!string.IsNullOrEmpty(Time) && (TimeSpan.TryParseExact(Time, @"hh\:mm", System.Globalization.CultureInfo.InvariantCulture, out var parsedTime) || TimeSpan.TryParse(Time, out parsedTime)))
                {
                    var targetStart = selectedDate.Date.Add(parsedTime);
                    var matchedSlot = slots.FirstOrDefault(s => s.Start == targetStart);
                    if (matchedSlot is not null && matchedSlot.Available)
                    {
                        SelectSlot(matchedSlot);
                        GoToStep3();
                    }
                    else
                    {
                        step = 2;
                    }
                }
                else
                {
                    step = 2;
                }
            }
        }

        var sessionEmail = await GetSessionEmailAsync();
        if (sessionEmail is not null)
        {
            isAuthenticated = true;
        }
    }

    private async Task<string?> GetSessionEmailAsync()
    {
        if (AuthStateTask is null)
        {
            return null;
        }

        var authState = await AuthStateTask;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return null;
        }

        var emailClaim = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value
            ?? user.FindFirst(c => c.Type == "email")?.Value;
        return string.IsNullOrEmpty(emailClaim) ? null : emailClaim;
    }

    private static DateTime StartOfWeek(DateTime date) => date.Date.AddDays(-(int)date.DayOfWeek);

    private IEnumerable<DateTime> WeekDays()
    {
        for (var i = 0; i < 7; i++)
        {
            yield return weekStart.AddDays(i);
        }
    }

    private static string FormatDuration(int minutes)
    {
        var hours = minutes / 60;
        var mins = minutes % 60;
        if (hours == 0) return $"{mins} min";
        return mins == 0 ? $"{hours}h" : $"{hours}h {mins}m";
    }

    private string StepClass(int forStep)
    {
        if (step > forStep) return "complete";
        if (step == forStep) return "active";
        return "";
    }

    private string GetLoginUrl()
    {
        var returnUrl = $"/book?serviceId={selectedServiceId}&date={selectedDate:yyyy-MM-dd}&time={selectedStart?.ToString("HH:mm")}";
        return $"/login?returnUrl={System.Net.WebUtility.UrlEncode(returnUrl)}";
    }

    private string GetRegisterUrl()
    {
        var returnUrl = $"/book?serviceId={selectedServiceId}&date={selectedDate:yyyy-MM-dd}&time={selectedStart?.ToString("HH:mm")}";
        return $"/register?returnUrl={System.Net.WebUtility.UrlEncode(returnUrl)}";
    }

    private void SelectService(int serviceId)
    {
        selectedServiceId = serviceId;
        selectedService = services?.FirstOrDefault(s => s.Id == serviceId);
        errorMessage = null;
    }

    private async Task GoToStep1()
    {
        step = 1;
        errorMessage = null;
        await Task.CompletedTask;
    }

    private async Task GoToStep2()
    {
        if (selectedServiceId == 0)
        {
            errorMessage = "Please select a treatment.";
            return;
        }

        step = 2;
        errorMessage = null;
        await LoadSlotsAsync();
    }

    private void GoToStep3()
    {
        if (selectedStart is null)
        {
            errorMessage = "Please select a time slot.";
            return;
        }

        step = 3;
        errorMessage = null;

        var targetUrl = $"/book?serviceId={selectedServiceId}&date={selectedDate:yyyy-MM-dd}&time={selectedStart.Value:HH:mm}";
        var targetUri = NavigationManager.ToAbsoluteUri(targetUrl);
        if (!string.Equals(NavigationManager.Uri, targetUri.ToString(), StringComparison.Ordinal))
        {
            NavigationManager.NavigateTo(targetUrl, replace: true);
        }
    }

    private async Task GoToPreviousWeek()
    {
        if (IsCurrentWeek) return;
        weekStart = weekStart.AddDays(-7);
        await Task.CompletedTask;
    }

    private async Task GoToNextWeek()
    {
        weekStart = weekStart.AddDays(7);
        await Task.CompletedTask;
    }

    private async Task SelectDate(DateTime date)
    {
        if (date.Date < ClinicClock.Today) return;
        selectedDate = date.Date;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        slots = new List<TimeSlot>();
        selectedStart = null;
        nextAvailableSlot = null;

        if (selectedServiceId == 0)
        {
            return;
        }

        loadingSlots = true;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var service = await db.Services.FindAsync(selectedServiceId);
        if (service is null)
        {
            loadingSlots = false;
            return;
        }

        var dayStart = selectedDate.Date;
        var dayEnd = dayStart.AddDays(1);

        var candidateProviderIds = (selectedProviderId != 0 ? new List<int> { selectedProviderId } : providers.Select(p => p.Id)).ToList();
        var schedule = await ProviderScheduleService.LoadAsync(db, candidateProviderIds, dayStart);

        // When a specific therapist is requested, only that therapist's
        // bookings block a slot - other therapists can still take clients at
        // the same time. With no preference, a slot is only unavailable once
        // every provider is booked at that time - one busy therapist out of
        // several shouldn't hide the slot from everyone.
        var existing = await db.Appointments
            .Where(a => a.AppointmentStatus != "Cancelled" && a.StartTime < dayEnd && a.EndTime > dayStart && a.ProviderId != null)
            .Select(a => new { a.ProviderId, a.StartTime, a.EndTime })
            .ToListAsync();

        var duration = TimeSpan.FromMinutes(service.DurationMinutes);
        var isToday = selectedDate.Date == ClinicClock.Today;
        var generated = new List<TimeSlot>();

        for (var start = dayStart.Add(OpeningTime); start.Add(duration) <= dayStart.Add(ClosingTime); start = start.Add(SlotInterval))
        {
            if (isToday && start <= ClinicClock.Now)
            {
                continue;
            }

            var end = start.Add(duration);
            bool available;
            if (selectedProviderId != 0)
            {
                available = schedule.IsWorking(selectedProviderId, start, end)
                    && !existing.Any(e => e.ProviderId == selectedProviderId && e.StartTime < end && start < e.EndTime);
            }
            else if (providers.Count > 0)
            {
                var busyProviderIds = existing.Where(e => e.StartTime < end && start < e.EndTime).Select(e => e.ProviderId).ToHashSet();
                available = providers.Any(p => schedule.IsWorking(p.Id, start, end) && !busyProviderIds.Contains(p.Id));
            }
            else
            {
                available = true;
            }

            generated.Add(new TimeSlot(start, end, available));
        }

        slots = generated;
        nextAvailableSlot = generated.FirstOrDefault(s => s.Available);
        loadingSlots = false;
    }

    private void SelectSlot(TimeSlot slot)
    {
        if (!slot.Available)
        {
            return;
        }

        selectedStart = slot.Start;
    }

    private async Task HandleBooking()
    {
        errorMessage = null;
        creatingCheckout = true;
        try
        {
            if (selectedServiceId == 0 || selectedStart is null)
            {
                errorMessage = "Please select a treatment and a time slot.";
                return;
            }

            var sessionEmail = await GetSessionEmailAsync();
            if (sessionEmail is null)
            {
                errorMessage = "You must be signed in to complete a booking.";
                return;
            }

            await using var db = await DbContextFactory.CreateDbContextAsync();

            var client = await db.Users.FirstOrDefaultAsync(u => u.Email == sessionEmail);
            if (client is null)
            {
                errorMessage = "Your user account could not be found.";
                return;
            }

            var service = await db.Services.FindAsync(selectedServiceId);
            if (service is null)
            {
                errorMessage = "Selected treatment is no longer available.";
                return;
            }

            var start = selectedStart.Value;
            var end = start.Add(TimeSpan.FromMinutes(service.DurationMinutes));

            var candidateProviderIds = (selectedProviderId != 0 ? new List<int> { selectedProviderId } : providers.Select(p => p.Id)).ToList();
            var schedule = await ProviderScheduleService.LoadAsync(db, candidateProviderIds, start.Date);

            var overlapping = await db.Appointments
                .Where(a => a.AppointmentStatus != "Cancelled" && a.StartTime < end && start < a.EndTime && a.ProviderId != null)
                .Select(a => a.ProviderId)
                .ToListAsync();

            int? assignedProviderId;
            if (selectedProviderId != 0)
            {
                assignedProviderId = schedule.IsWorking(selectedProviderId, start, end) && !overlapping.Contains(selectedProviderId)
                    ? selectedProviderId
                    : null;
            }
            else if (providers.Count > 0)
            {
                assignedProviderId = providers.Select(p => (int?)p.Id)
                    .FirstOrDefault(id => schedule.IsWorking(id!.Value, start, end) && !overlapping.Contains(id));
            }
            else
            {
                assignedProviderId = null;
            }

            var stillAvailable = selectedProviderId != 0 ? assignedProviderId is not null : providers.Count == 0 || assignedProviderId is not null;
            if (!stillAvailable)
            {
                errorMessage = "That time slot was just booked by someone else. Please choose another.";
                step = 2;
                await LoadSlotsAsync();
                return;
            }

            // No Appointment row is created here at all - nothing goes into
            // the database until Stripe actually confirms payment succeeded
            // (see StripeWebhookEndpoints.MarkAppointmentPaidAsync). The full
            // booking is carried as Stripe session metadata instead, so an
            // abandoned or failed checkout leaves zero trace in the DB.
            var returnUrl = new Uri(new Uri(NavigationManager.BaseUri), "/book/payment-complete");
            var bookingMetadata = new Dictionary<string, string>
            {
                ["clientId"] = client.Id.ToString(),
                ["serviceId"] = service.Id.ToString(),
                // Deliberately 0 ("no preference"), not the provider found
                // just now, when the client didn't request a specific one -
                // otherwise this would lock in whichever provider happened
                // to be first here, and the load-balanced assignment the
                // webhook does at actual payment time (see
                // StripeWebhookEndpoints.MarkAppointmentPaidAsync) would
                // never run since it treats a nonzero providerId as a hard
                // request.
                ["providerId"] = (selectedProviderId != 0 ? assignedProviderId ?? 0 : 0).ToString(),
                ["startTime"] = start.ToString("O"),
                ["endTime"] = end.ToString("O"),
            };
            var session = await StripeCheckout.CreateEmbeddedSessionAsync(service.Name, service.Price, returnUrl, bookingMetadata);

            checkoutClientSecret = session.ClientSecret;
            checkoutMounted = false;
            awaitingPayment = true;
            step = 4;
        }
        finally
        {
            creatingCheckout = false;
        }
    }

    private async Task GoBackToReview()
    {
        awaitingPayment = false;
        checkoutMounted = false;
        checkoutClientSecret = null;
        step = 3;

        if (stripeModule is not null)
        {
            await stripeModule.InvokeVoidAsync("destroyCheckout");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (awaitingPayment && !checkoutMounted && checkoutClientSecret is not null)
        {
            checkoutMounted = true;
            stripeModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/stripeCheckout.js");
            await stripeModule.InvokeVoidAsync("mountCheckout", StripeSettings.Value.PublishableKey, checkoutClientSecret, "stripe-checkout-container");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (stripeModule is not null)
        {
            try
            {
                await stripeModule.InvokeVoidAsync("destroyCheckout");
                await stripeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone - nothing to clean up.
            }
        }
    }

    private record TimeSlot(DateTime Start, DateTime End, bool Available);
}
