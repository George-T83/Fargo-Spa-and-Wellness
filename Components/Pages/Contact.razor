@page "/contact"
@rendermode InteractiveServer
@using Family_and_Spa_Wellness.Services
@using Microsoft.Extensions.Options
@inject IEmailSender EmailSender
@inject IOptions<SmtpOptions> SmtpConfig

<PageTitle>Contact Us - Fargo Spa and Wellness</PageTitle>

<section class="catalog-header">
    <div class="container">
        <p class="eyebrow">Get In Touch</p>
        <h1 class="section-title">Contact Us</h1>
        <p class="catalog-subtitle">Have a question or want to visit us in person? We'd love to hear from you.</p>
    </div>
</section>

<section class="services-section">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info-col">
                <div class="auth-card">
                    <h2 class="contact-card-title">Visit or reach us</h2>

                    <div class="contact-info-row">
                        <span class="contact-info-icon">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                        </span>
                        <div>
                            <p class="contact-info-label">Address</p>
                            <p class="contact-info-text">1910 42nd St S B<br />Fargo, ND 58103</p>
                        </div>
                    </div>

                    <div class="contact-info-row">
                        <span class="contact-info-icon">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" /></svg>
                        </span>
                        <div>
                            <p class="contact-info-label">Phone</p>
                            <p class="contact-info-text">(701) 555-0100</p>
                        </div>
                    </div>

                    <div class="contact-info-row">
                        <span class="contact-info-icon">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                        </span>
                        <div>
                            <p class="contact-info-label">Email</p>
                            <p class="contact-info-text">hello@fargospa.com</p>
                        </div>
                    </div>

                    <div class="contact-info-row">
                        <span class="contact-info-icon">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                        </span>
                        <div>
                            <p class="contact-info-label">Hours</p>
                            <p class="contact-info-text">Mon&ndash;Fri: 9am &ndash; 8pm<br />Sat&ndash;Sun: 10am &ndash; 6pm</p>
                        </div>
                    </div>
                </div>

                <div class="contact-map-wrap">
                    <iframe class="contact-map" title="Fargo Spa and Wellness location"
                            src="https://www.google.com/maps?q=1910+42nd+St+S,+Fargo,+ND+58103&z=15&output=embed"
                            loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <div class="contact-form-col">
                <div class="auth-card">
                    <h2 class="contact-card-title">Send us a message</h2>
                    <p class="contact-card-subtitle">We typically respond within one business day.</p>

                    @if (submitted)
                    {
                        <div class="alert alert-success" role="alert">Thanks for reaching out &mdash; we'll be in touch soon.</div>
                    }
                    else
                    {
                        <EditForm Model="model" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">@errorMessage</div>
                            }

                            <div class="auth-field">
                                <label class="auth-label">Your name</label>
                                <InputText class="auth-input" placeholder="Sarah Mitchell" @bind-Value="model.Name" />
                                <ValidationMessage For="() => model.Name" class="auth-error" />
                            </div>

                            <div class="auth-field">
                                <label class="auth-label">Email</label>
                                <InputText class="auth-input" placeholder="you@email.com" @bind-Value="model.Email" />
                                <ValidationMessage For="() => model.Email" class="auth-error" />
                            </div>

                            <div class="auth-field">
                                <label class="auth-label">Subject</label>
                                <InputText class="auth-input" placeholder="General inquiry" @bind-Value="model.Subject" />
                                <ValidationMessage For="() => model.Subject" class="auth-error" />
                            </div>

                            <div class="auth-field">
                                <label class="auth-label">Message</label>
                                <InputTextArea class="auth-input" rows="5" placeholder="Tell us how we can help..." @bind-Value="model.Message" />
                                <ValidationMessage For="() => model.Message" class="auth-error" />
                            </div>

                            <button type="submit" class="btn btn-spa-primary w-100" disabled="@sending">
                                @(sending ? "Sending..." : "Send message")
                            </button>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly ContactModel model = new();
    private bool sending;
    private bool submitted;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        sending = true;
        errorMessage = null;

        var businessEmail = SmtpConfig.Value.FromEmail;
        var encodedMessage = System.Net.WebUtility.HtmlEncode(model.Message).Replace("\n", "<br />");

        await EmailSender.SendAsync(
            businessEmail,
            $"New contact inquiry: {model.Subject}",
            $"<p><strong>From:</strong> {System.Net.WebUtility.HtmlEncode(model.Name)} ({System.Net.WebUtility.HtmlEncode(model.Email)})</p>" +
            $"<p><strong>Subject:</strong> {System.Net.WebUtility.HtmlEncode(model.Subject)}</p>" +
            $"<p>{encodedMessage}</p>");

        await EmailSender.SendAsync(
            model.Email,
            "We received your message - Fargo Spa and Wellness",
            $"<p>Hi {System.Net.WebUtility.HtmlEncode(model.Name)},</p>" +
            "<p>Thanks for reaching out to Fargo Spa and Wellness. We've received your message and will get back to you within one business day.</p>" +
            $"<p><strong>Your message:</strong><br />{encodedMessage}</p>");

        sending = false;
        submitted = true;
    }

    private class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your name")]
        [System.ComponentModel.DataAnnotations.MinLength(2, ErrorMessage = "Enter your full name")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your email")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a subject")]
        [System.ComponentModel.DataAnnotations.MinLength(2, ErrorMessage = "Enter a subject")]
        public string Subject { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a message")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "Message must be at least 10 characters")]
        public string Message { get; set; } = string.Empty;
    }
}
