@page "/register"
@rendermode InteractiveServer
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IEmailSender EmailSender
@inject NavigationManager NavigationManager

<PageTitle>Create an Account - Fargo Spa and Wellness</PageTitle>

<div class="auth-shell">
    <div class="auth-shell-inner">
        <div class="auth-header">
            <div class="auth-icon">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1" />
                    <path d="M12 8v13" />
                    <path d="M12 21c0-2.5-2-2.5-2-5" />
                    <path d="M12 21c0-2.5 2-2.5 2-5" />
                </svg>
            </div>
            <h1 class="auth-title">Create your account</h1>
            <p class="auth-subtitle">Join Fargo Spa to book treatments and track your visits</p>
        </div>

        <div class="auth-card">
            @if (submitted)
            {
                <div class="alert alert-success mb-0" role="alert">
                    Welcome, @model.FirstName! Your account has been created.
                    A confirmation email has been sent to @model.Email.
                </div>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="HandleRegister">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }

                    <div class="auth-field">
                        <label class="auth-label">First name</label>
                        <InputText class="auth-input" placeholder="Sarah" @bind-Value="model.FirstName" />
                        <ValidationMessage For="() => model.FirstName" class="auth-error" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-label">Last name</label>
                        <InputText class="auth-input" placeholder="Mitchell" @bind-Value="model.LastName" />
                        <ValidationMessage For="() => model.LastName" class="auth-error" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-label">Email address</label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                            </span>
                            <InputText type="email" class="auth-input has-icon" placeholder="you@email.com" @bind-Value="model.Email" />
                        </div>
                        <ValidationMessage For="() => model.Email" class="auth-error" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-label">Phone number</label>
                        <InputText class="auth-input" placeholder="(701) 555-0142" @bind-Value="model.Phone" />
                        <ValidationMessage For="() => model.Phone" class="auth-error" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-label">Password</label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            </span>
                            <InputText type="password" class="auth-input has-icon" placeholder="Create a password" @bind-Value="model.Password" @oninput="OnPasswordInput" />
                        </div>
                        @if (!string.IsNullOrEmpty(livePassword))
                        {
                            var strength = ComputeStrength(livePassword);
                            <div class="auth-strength">
                                @for (var i = 1; i <= 4; i++)
                                {
                                    var filled = i <= strength;
                                    <span class="auth-strength-bar @(filled ? StrengthClass(strength) : "")"></span>
                                }
                                <span class="auth-strength-label">@StrengthLabel(strength)</span>
                            </div>
                        }
                        <ValidationMessage For="() => model.Password" class="auth-error" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-label">Confirm password</label>
                        <InputText type="password" class="auth-input" placeholder="Re-enter your password" @bind-Value="model.ConfirmPassword" />
                        <ValidationMessage For="() => model.ConfirmPassword" class="auth-error" />
                    </div>

                    <button type="submit" class="btn btn-spa-primary w-100">Create account &rarr;</button>
                </EditForm>
            }
        </div>

        <p class="auth-footer-link">
            Already have an account? <a href="@(string.IsNullOrEmpty(ReturnUrl) ? "/login" : $"/login?returnUrl={System.Net.WebUtility.UrlEncode(ReturnUrl)}")">Sign in</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly RegisterModel model = new();
    private bool submitted;
    private string? errorMessage;
    private string livePassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\"))
        {
            NavigationManager.NavigateTo(ReturnUrl);
            return;
        }

        var redirectUrl = user.IsInRole("Admin") ? "/admin" : user.IsInRole("Provider") ? "/admin/dashboard" : "/dashboard";
        NavigationManager.NavigateTo(redirectUrl);
    }

    private void OnPasswordInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        livePassword = e.Value?.ToString() ?? string.Empty;
    }

    private static int ComputeStrength(string pw)
    {
        var score = 0;
        if (pw.Length >= 8) score++;
        if (pw.Any(char.IsUpper)) score++;
        if (pw.Any(char.IsDigit)) score++;
        if (pw.Any(c => !char.IsLetterOrDigit(c))) score++;
        return score;
    }

    private static string StrengthLabel(int strength) => strength switch
    {
        <= 1 => "Weak",
        2 => "Fair",
        3 => "Good",
        _ => "Strong",
    };

    private static string StrengthClass(int strength) => strength switch
    {
        <= 1 => "weak",
        2 => "fair",
        3 => "good",
        _ => "strong",
    };

    private async Task HandleRegister()
    {
        errorMessage = null;

        await using var db = await DbContextFactory.CreateDbContextAsync();

        var normalizedEmail = model.Email.Trim().ToLowerInvariant();

        var emailTaken = await db.Users.AnyAsync(u => u.Email == normalizedEmail);
        if (emailTaken)
        {
            errorMessage = "An account with this email already exists.";
            return;
        }

        var hasher = new PasswordHasher<User>();
        var user = new User
        {
            FirstName = model.FirstName.Trim(),
            LastName = model.LastName.Trim(),
            Email = normalizedEmail,
            Phone = model.Phone,
            Role = "Client",
        };
        user.PasswordHash = hasher.HashPassword(user, model.Password);

        db.Users.Add(user);
        await db.SaveChangesAsync();

        await EmailSender.SendAsync(
            user.Email,
            "Welcome to Fargo Spa and Wellness",
            $"<p>Hi {user.FirstName},</p><p>Your account has been created. We look forward to seeing you at Fargo Spa and Wellness.</p>");

        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            NavigationManager.NavigateTo($"/login?returnUrl={System.Net.WebUtility.UrlEncode(ReturnUrl)}");
        }
        else
        {
            submitted = true;
        }
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First name is required")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last name is required")]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Phone number is required")]
        [System.ComponentModel.DataAnnotations.Phone(ErrorMessage = "Enter a valid phone number")]
        public string Phone { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
