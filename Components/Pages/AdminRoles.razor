@page "/admin/roles"
@attribute [Authorize(Roles = "Admin")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>User Role Management - Fargo Spa and Wellness</PageTitle>

<section class="catalog-header">
    <div class="container">
        <p class="eyebrow">Admin</p>
        <h1 class="section-title">User Role Management</h1>
        <p class="catalog-subtitle">View registered users and assign roles.</p>
    </div>
</section>

<section class="container py-5">
    @if (users is null)
    {
        <p>Loading users...</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <div class="fs-3 fw-bold">@users.Count(u => u.Role == "Client")</div>
                    <div class="text-muted">Clients</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <div class="fs-3 fw-bold">@users.Count(u => u.Role == "Provider")</div>
                    <div class="text-muted">Providers</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <div class="fs-3 fw-bold">@users.Count(u => u.Role == "Admin")</div>
                    <div class="text-muted">Admins</div>
                </div>
            </div>
        </div>

        @if (statusMessage is not null)
        {
            <div class="alert alert-success">@statusMessage</div>
        }

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Contact</th>
                    <th>Role</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>
                            <div>@user.Email</div>
                            <div class="text-muted">@user.Phone</div>
                        </td>
                        <td>
                            <select class="form-select form-select-sm" style="width: auto;"
                                    value="@user.Role"
                                    @onchange="@(e => ChangeRole(user, e.Value?.ToString() ?? user.Role))">
                                <option value="Client">Client</option>
                                <option value="Provider">Provider</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </td>
                        <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private List<User>? users;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        users = await db.Users.OrderBy(u => u.LastName).ToListAsync();
    }

    private async Task ChangeRole(User user, string newRole)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbUser = await db.Users.FindAsync(user.Id);
        if (dbUser is not null)
        {
            dbUser.Role = newRole;
            await db.SaveChangesAsync();
            statusMessage = $"{dbUser.FullName}'s role updated to {newRole}.";
            await LoadUsers();
        }
    }
}