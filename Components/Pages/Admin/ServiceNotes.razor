@page "/admin/notes"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Provider,Admin")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JsRuntime

<PageTitle>Client Service Notes - Fargo Spa and Wellness</PageTitle>

<LayoutView Layout="@CurrentLayout">
<div class="admin-page-header">
    <h1>Client Service Notes</h1>
    <p>Allergies, preferences, and care details staff should know about a client.</p>
</div>

@if (notes is null)
{
    <p>Loading...</p>
}
else
{
    @if (statusMessage is not null)
    {
        <div class="admin-alert">@statusMessage</div>
    }

    <div class="admin-filter-bar">
        <input class="admin-search-input" type="text" placeholder="Search client or note text..." @bind="searchText" @bind:event="oninput" />
        <select class="admin-role-select" @bind="selectedType">
            <option value="All">All types</option>
            <option value="Allergy">Allergy</option>
            <option value="Preference">Preference</option>
            <option value="General">General</option>
        </select>
        <button type="button" class="btn btn-spa-primary" @onclick="StartCreate">+ Add note</button>
    </div>

    @if (showForm)
    {
        <div class="admin-form-card">
            <h3>@(editingNoteId is null ? "New Note" : "Edit Note")</h3>

            @if (validationErrors.Count > 0)
            {
                <div class="admin-alert">
                    @foreach (var error in validationErrors)
                    {
                        <div>@error</div>
                    }
                </div>
            }

            <div class="admin-form-grid">
                <div class="admin-form-field">
                    <label>Client</label>
                    <select class="admin-role-select" @bind="newClientId">
                        <option value="0">Select a client...</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.Id">@client.FullName</option>
                        }
                    </select>
                </div>
                <div class="admin-form-field">
                    <label>Category</label>
                    <select class="admin-role-select" @bind="newNoteType">
                        <option value="Allergy">Allergy</option>
                        <option value="Preference">Preference</option>
                        <option value="General">General</option>
                    </select>
                </div>
            </div>
            <div class="admin-form-field mb-3">
                <label>Note</label>
                <textarea rows="3" @bind="newNoteText"></textarea>
            </div>

            <div class="admin-service-actions">
                <button type="button" class="btn btn-spa-primary" @onclick="SaveAsync">Save</button>
                <button type="button" class="btn btn-spa-secondary" @onclick="CancelCreate">Cancel</button>
            </div>
        </div>
    }

    @if (FilteredNotes.Count == 0)
    {
        <div class="admin-coming-soon">
            <p>No notes match this view.</p>
        </div>
    }
    else
    {
        <div class="notes-grid">
            @foreach (var note in FilteredNotes)
            {
                <div class="note-card">
                    <div class="note-card-header">
                        <span class="note-client-name">@(note.Client?.FullName ?? "Unknown client")</span>
                        <span class="note-type-badge @note.NoteType.ToLowerInvariant()">@note.NoteType</span>
                    </div>
                    <p class="note-text">@note.NoteText</p>
                    <div class="note-card-footer">
                        <span>@(note.Author?.FullName ?? "Unknown staff") &middot; @note.CreatedAt.ToString("MMM d, yyyy")</span>
                        <div class="note-card-actions">
                            <button type="button" class="btn btn-spa-secondary btn-sm" @onclick="() => StartEdit(note)">Edit</button>
                            <button type="button" class="btn-reject btn-sm" @onclick="() => ConfirmAndDeleteAsync(note)">Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
</LayoutView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int authorId;
    private bool isAdmin;
    private Type CurrentLayout => isAdmin ? typeof(AdminLayout) : typeof(ProviderLayout);
    private List<User> clients = new();
    private List<ServiceNote>? notes;
    private string searchText = string.Empty;
    private string selectedType = "All";
    private string? statusMessage;

    private bool showForm;
    private int? editingNoteId;
    private int newClientId;
    private string newNoteType = "General";
    private string newNoteText = string.Empty;
    private List<string> validationErrors = new();

    private List<ServiceNote> FilteredNotes => (notes ?? new())
        .Where(n => selectedType == "All" || n.NoteType == selectedType)
        .Where(n => string.IsNullOrWhiteSpace(searchText)
            || (n.Client?.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            || n.NoteText.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(n => n.CreatedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out authorId))
        {
            return;
        }

        isAdmin = authState.User.IsInRole("Admin");

        await using var db = await DbContextFactory.CreateDbContextAsync();

        // Providers can only see and add notes for clients they've actually
        // been booked with - not the entire client list. Admins see and can
        // note for everyone.
        var clientsQuery = db.Users.Where(u => u.Role == "Client");
        if (!isAdmin)
        {
            var seenClientIds = await db.Appointments
                .Where(a => a.ProviderId == authorId)
                .Select(a => a.ClientId)
                .Distinct()
                .ToListAsync();
            clientsQuery = clientsQuery.Where(u => seenClientIds.Contains(u.Id));
        }
        clients = await clientsQuery.OrderBy(u => u.LastName).ToListAsync();

        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var visibleClientIds = clients.Select(c => c.Id).ToHashSet();

        var notesQuery = db.ServiceNotes.AsQueryable();
        if (!isAdmin)
        {
            // Also include notes this provider wrote themselves, in case a
            // note exists for a client with no current matching appointment
            // (e.g. the appointment was later cancelled or reassigned).
            notesQuery = notesQuery.Where(n => visibleClientIds.Contains(n.ClientId) || n.AuthorId == authorId);
        }

        notes = await notesQuery
            .Include(n => n.Client)
            .Include(n => n.Author)
            .OrderByDescending(n => n.CreatedAt)
            .ToListAsync();
    }

    private void StartCreate()
    {
        showForm = true;
        editingNoteId = null;
        newClientId = 0;
        newNoteType = "General";
        newNoteText = string.Empty;
        validationErrors.Clear();
        statusMessage = null;
    }

    private void StartEdit(ServiceNote note)
    {
        showForm = true;
        editingNoteId = note.Id;
        newClientId = note.ClientId;
        newNoteType = note.NoteType;
        newNoteText = note.NoteText;
        validationErrors.Clear();
        statusMessage = null;
    }

    private void CancelCreate()
    {
        showForm = false;
        editingNoteId = null;
        validationErrors.Clear();
    }

    private async Task SaveAsync()
    {
        validationErrors = new List<string>();
        if (newClientId == 0)
        {
            validationErrors.Add("Client is required.");
        }
        if (string.IsNullOrWhiteSpace(newNoteText))
        {
            validationErrors.Add("Note text is required.");
        }
        if (validationErrors.Count > 0)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();

        if (editingNoteId is null)
        {
            db.ServiceNotes.Add(new ServiceNote
            {
                ClientId = newClientId,
                AuthorId = authorId,
                NoteType = newNoteType,
                NoteText = newNoteText,
            });
            statusMessage = "Note added.";
        }
        else
        {
            var dbNote = await db.ServiceNotes.FindAsync(editingNoteId.Value);
            if (dbNote is not null)
            {
                dbNote.ClientId = newClientId;
                dbNote.NoteType = newNoteType;
                dbNote.NoteText = newNoteText;
                statusMessage = "Note updated.";
            }
        }

        await db.SaveChangesAsync();

        showForm = false;
        editingNoteId = null;
        await LoadNotesAsync();
    }

    private async Task ConfirmAndDeleteAsync(ServiceNote note)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Delete this note? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbNote = await db.ServiceNotes.FindAsync(note.Id);
        if (dbNote is not null)
        {
            db.ServiceNotes.Remove(dbNote);
            await db.SaveChangesAsync();
            statusMessage = "Note deleted.";
        }

        await LoadNotesAsync();
    }
}
