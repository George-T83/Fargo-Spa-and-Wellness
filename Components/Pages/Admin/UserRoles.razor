@page "/admin/users"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>User Roles - Fargo Spa and Wellness</PageTitle>

<div class="admin-page-header">
    <h1>User Roles</h1>
    <p>Manage Client, Provider, and Admin access.</p>
</div>

@if (users is null)
{
    <p>Loading users...</p>
}
else
{
    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-value">@users.Count(u => u.Role == "Client")</div>
            <div class="admin-stat-label">Clients</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-value">@users.Count(u => u.Role == "Provider")</div>
            <div class="admin-stat-label">Providers</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-value">@users.Count(u => u.Role == "Admin")</div>
            <div class="admin-stat-label">Admins</div>
        </div>
    </div>

    @if (statusMessage is not null)
    {
        <div class="admin-alert">@statusMessage</div>
    }

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Contact</th>
                    <th>Role</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>
                            <div>@user.Email</div>
                            <div class="text-muted">@user.Phone</div>
                        </td>
                        <td>
                            @if (user.Id == currentUserId)
                            {
                                <select class="admin-role-select" value="@user.Role" disabled title="You can't change your own role.">
                                    <option value="@user.Role">@user.Role</option>
                                </select>
                            }
                            else
                            {
                                <select class="admin-role-select"
                                        value="@user.Role"
                                        @onchange="@(e => ChangeRole(user, e.Value?.ToString() ?? user.Role))">
                                    <option value="Client">Client</option>
                                    <option value="Provider">Provider</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<User>? users;
    private string? statusMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
            int.TryParse(idClaim, out currentUserId);
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        users = await db.Users.OrderBy(u => u.LastName).ToListAsync();
    }

    private async Task ChangeRole(User user, string newRole)
    {
        // Never let an admin change their own role here, even if someone
        // bypasses the disabled UI control - self-demoting (or a bug doing
        // it for them) could lock every admin out of this page with no way
        // back in, since the startup admin-seed step only runs when zero
        // admins exist.
        if (user.Id == currentUserId)
        {
            statusMessage = "You can't change your own role.";
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbUser = await db.Users.FindAsync(user.Id);
        if (dbUser is not null)
        {
            dbUser.Role = newRole;
            await db.SaveChangesAsync();
            statusMessage = $"{dbUser.FullName}'s role updated to {newRole}.";
            await LoadUsers();
        }
    }
}
