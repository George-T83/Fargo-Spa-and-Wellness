@page "/admin/calendar"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JsRuntime
@inject AppointmentNotificationService NotificationService
@inject IEmailSender EmailSender
@inject NavigationManager NavigationManager
@inject StripeCheckoutService StripeCheckout

<PageTitle>Master Calendar - Fargo Spa and Wellness</PageTitle>

<div class="admin-page-header">
    <h1>Master Calendar</h1>
    <p>View all bookings, resolve conflicts, and apply overrides.</p>
</div>

@if (appointments is null)
{
    <p>Loading...</p>
}
else
{
    <div class="calendar-toolbar">
        <div class="calendar-week-nav">
            <button type="button" class="calendar-nav-btn" @onclick="GoToPreviousWeek">&larr;</button>
            <span class="calendar-week-label">@WeekLabel</span>
            <button type="button" class="calendar-nav-btn" @onclick="GoToNextWeek">&rarr;</button>
            <button type="button" class="btn btn-spa-secondary btn-sm" @onclick="GoToToday">Today</button>
        </div>
        <div class="calendar-toolbar-right">
            <select class="admin-role-select" @bind="selectedProviderFilter" @bind:after="LoadWeekAsync">
                <option value="0">All providers</option>
                @foreach (var provider in providers)
                {
                    <option value="@provider.Id">@provider.FullName</option>
                }
            </select>
            <button type="button" class="btn btn-spa-primary btn-sm" @onclick="StartCreate">+ New booking</button>
        </div>
    </div>

    @if (conflictCount > 0)
    {
        <div class="calendar-conflict-banner">
            @conflictCount scheduling conflict@(conflictCount == 1 ? "" : "s") detected this week - review and resolve below.
        </div>
    }

    @if (statusMessage is not null)
    {
        <div class="admin-alert">@statusMessage</div>
    }

    @if (editingAppointment is not null)
    {
        <div class="admin-form-card">
            <h3>@(editingAppointment.Id == 0 ? "New Booking" : "Edit Booking")</h3>

            @if (validationErrors.Count > 0)
            {
                <div class="admin-alert">
                    @foreach (var error in validationErrors)
                    {
                        <div>@error</div>
                    }
                </div>
            }

            <div class="admin-form-grid">
                <div class="admin-form-field">
                    <label>Client</label>
                    <select class="admin-role-select" @bind="editingAppointment.ClientId">
                        <option value="0">Select a client...</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.Id">@client.FullName</option>
                        }
                    </select>
                </div>
                <div class="admin-form-field">
                    <label>Service</label>
                    <select class="admin-role-select" @bind="editingAppointment.ServiceId" @bind:after="ApplyServiceDuration">
                        <option value="0">Select a service...</option>
                        @foreach (var service in services)
                        {
                            <option value="@service.Id">@service.Name (@service.DurationMinutes min)</option>
                        }
                    </select>
                </div>
                <div class="admin-form-field">
                    <label>Provider</label>
                    <select class="admin-role-select" @bind="editingProviderId">
                        <option value="0">Unassigned</option>
                        @foreach (var provider in providers)
                        {
                            <option value="@provider.Id">@provider.FullName</option>
                        }
                    </select>
                </div>
                <div class="admin-form-field">
                    <label>Start</label>
                    <input type="datetime-local" @bind="editingAppointment.StartTime" />
                </div>
                <div class="admin-form-field">
                    <label>End</label>
                    <input type="datetime-local" @bind="editingAppointment.EndTime" />
                </div>
            </div>

            <div class="admin-service-actions admin-service-actions-split">
                <div class="admin-service-actions-left">
                    <button type="button" class="btn btn-spa-primary" @onclick="SaveAsync">Save</button>
                    <button type="button" class="btn btn-spa-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
                @if (editingAppointment.Id != 0)
                {
                    <button type="button" class="btn-reject" @onclick="ConfirmAndCancelBookingAsync">Cancel Booking</button>
                }
            </div>

            @if (editingAppointment.Id != 0 && editingAppointment.EndTime < ClinicClock.Now)
            {
                <div class="admin-service-actions" style="margin-top:0.5rem;">
                    @if (editingAppointment.AppointmentStatus == "Scheduled")
                    {
                        <button type="button" class="btn btn-spa-primary btn-sm" @onclick='() => MarkOutcomeAsync(editingAppointment, "Completed")'>Mark Complete</button>
                        <button type="button" class="btn-reject btn-sm" @onclick='() => MarkOutcomeAsync(editingAppointment, "NoShow")'>Mark No-Show</button>
                    }
                    else
                    {
                        <span class="admin-status-badge @StatusBadgeClass(editingAppointment.AppointmentStatus)">@editingAppointment.AppointmentStatus</span>
                    }
                </div>
            }

            @if (editingAppointment.Id != 0 && editingAppointment.AppointmentStatus != "Cancelled")
            {
                <div class="admin-service-actions" style="margin-top:0.5rem;">
                    <span class="admin-status-badge @PaymentBadgeClass(editingAppointment.PaymentStatus)">@(string.IsNullOrEmpty(editingAppointment.PaymentStatus) ? "Unpaid" : editingAppointment.PaymentStatus)</span>
                    @if (string.IsNullOrEmpty(editingAppointment.PaymentStatus) || editingAppointment.PaymentStatus == "Unpaid")
                    {
                        <button type="button" class="btn btn-spa-secondary btn-sm" @onclick="MarkPaidAsync">Mark as paid</button>
                    }
                </div>
            }
        </div>
    }

    <div class="calendar-grid-wrap">
        <div class="calendar-grid">
            <div class="calendar-time-header"></div>
            @foreach (var day in WeekDays)
            {
                <div class="calendar-day-header @(day.Date == ClinicClock.Today ? "today" : "")">@day.ToString("ddd M/d")</div>
            }

            <div class="calendar-time-col">
                @for (var hour = StartHour; hour < EndHour; hour++)
                {
                    <div class="calendar-time-label">@(new DateTime(1, 1, 1, hour, 0, 0).ToString("h tt"))</div>
                }
            </div>

            @foreach (var day in WeekDays)
            {
                <div class="calendar-day-body" style="height:@((EndHour - StartHour) * PxPerHour)px">
                    @foreach (var appt in appointments.Where(a => a.StartTime.Date == day.Date))
                    {
                        <div class="calendar-appt-block @(conflictIds.Contains(appt.Id) ? "conflict" : "")"
                             style="top:@(BlockTop(appt))px; height:@(BlockHeight(appt))px"
                             title="@BlockTooltip(appt)"
                             @onclick="() => StartEdit(appt)">
                            <span class="calendar-appt-time">@appt.StartTime.ToString("h:mmtt")</span>
                            <span>@(appt.Client?.FullName ?? "Unknown client")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private const int StartHour = 8;
    private const int EndHour = 19;
    private const int PxPerHour = 60;

    private DateTime weekStart = StartOfWeek(ClinicClock.Today);
    private List<User> providers = new();
    private List<User> clients = new();
    private List<Service> services = new();
    private int selectedProviderFilter;
    private List<Appointment>? appointments;
    private HashSet<int> conflictIds = new();
    private int conflictCount;

    private Appointment? editingAppointment;
    private int editingProviderId;
    private List<string> validationErrors = new();
    private string? statusMessage;

    private IEnumerable<DateTime> WeekDays => Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i));
    private string WeekLabel => $"{weekStart.ToString("MMMM yyyy")} - Week of {weekStart.ToString("MMM d")}";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        providers = await db.Users.Where(u => u.Role == "Provider").OrderBy(u => u.LastName).ToListAsync();
        clients = await db.Users.Where(u => u.Role == "Client").OrderBy(u => u.LastName).ToListAsync();
        services = await db.Services.Where(s => s.IsActive).OrderBy(s => s.Name).ToListAsync();

        await LoadWeekAsync();
    }

    private async Task LoadWeekAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var weekEnd = weekStart.AddDays(7);

        var query = db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Service)
            .Include(a => a.Provider)
            .Where(a => a.AppointmentStatus != "Cancelled" && a.StartTime >= weekStart && a.StartTime < weekEnd);

        if (selectedProviderFilter != 0)
        {
            query = query.Where(a => a.ProviderId == selectedProviderFilter);
        }

        appointments = await query.OrderBy(a => a.StartTime).ToListAsync();

        // Conflict = same non-null ProviderId with overlapping [StartTime, EndTime)
        // ranges. Appointments with no provider assigned aren't checked -
        // there's no shared resource to conflict over yet, since the
        // client-facing booking flow doesn't assign a provider (confirmed
        // with Moses before building this).
        conflictIds = new HashSet<int>();
        foreach (var group in appointments.Where(a => a.ProviderId.HasValue).GroupBy(a => a.ProviderId!.Value))
        {
            var list = group.ToList();
            for (var i = 0; i < list.Count; i++)
            {
                for (var j = i + 1; j < list.Count; j++)
                {
                    if (list[i].StartTime < list[j].EndTime && list[j].StartTime < list[i].EndTime)
                    {
                        conflictIds.Add(list[i].Id);
                        conflictIds.Add(list[j].Id);
                    }
                }
            }
        }
        conflictCount = conflictIds.Count;
    }

    private async Task GoToPreviousWeek()
    {
        weekStart = weekStart.AddDays(-7);
        await LoadWeekAsync();
    }

    private async Task GoToNextWeek()
    {
        weekStart = weekStart.AddDays(7);
        await LoadWeekAsync();
    }

    private async Task GoToToday()
    {
        weekStart = StartOfWeek(ClinicClock.Today);
        await LoadWeekAsync();
    }

    private static DateTime StartOfWeek(DateTime date) => date.Date.AddDays(-(int)date.DayOfWeek);

    private double BlockTop(Appointment appt)
    {
        var minutesFromStart = (appt.StartTime.Hour - StartHour) * 60 + appt.StartTime.Minute;
        var top = minutesFromStart / 60.0 * PxPerHour;
        return Math.Max(0, top);
    }

    private double BlockHeight(Appointment appt)
    {
        var durationMinutes = Math.Max((appt.EndTime - appt.StartTime).TotalMinutes, 15);
        return durationMinutes / 60.0 * PxPerHour;
    }

    private static string BlockTooltip(Appointment appt) =>
        $"{appt.StartTime:h:mm tt}-{appt.EndTime:h:mm tt}: {appt.Client?.FullName} - {appt.Service?.Name}" +
        (appt.Provider is not null ? $" (with {appt.Provider.FullName})" : " (unassigned)");

    private void StartCreate()
    {
        var defaultStart = ClinicClock.Today.AddHours(9);
        editingAppointment = new Appointment { StartTime = defaultStart, EndTime = defaultStart.AddHours(1) };
        editingProviderId = 0;
        validationErrors.Clear();
        statusMessage = null;
    }

    private void StartEdit(Appointment appt)
    {
        // The Client/Provider dropdowns are normally filtered to
        // Role == "Client"/"Provider", but a handful of test bookings were
        // made against Admin/Provider accounts directly - without this, the
        // dropdown has no matching <option> for that user's Id and silently
        // renders blank even though the underlying value is set correctly.
        if (appt.Client is not null && !clients.Any(c => c.Id == appt.Client.Id))
        {
            clients.Add(appt.Client);
        }
        if (appt.Provider is not null && !providers.Any(p => p.Id == appt.Provider.Id))
        {
            providers.Add(appt.Provider);
        }

        editingAppointment = new Appointment
        {
            Id = appt.Id,
            ClientId = appt.ClientId,
            ServiceId = appt.ServiceId,
            ProviderId = appt.ProviderId,
            StartTime = appt.StartTime,
            EndTime = appt.EndTime,
        };
        editingProviderId = appt.ProviderId ?? 0;
        validationErrors.Clear();
        statusMessage = null;
    }

    private void CancelEdit()
    {
        editingAppointment = null;
        validationErrors.Clear();
    }

    private void ApplyServiceDuration()
    {
        if (editingAppointment is null)
        {
            return;
        }

        var service = services.FirstOrDefault(s => s.Id == editingAppointment.ServiceId);
        if (service is not null)
        {
            editingAppointment.EndTime = editingAppointment.StartTime.AddMinutes(service.DurationMinutes);
        }
    }

    private async Task SaveAsync()
    {
        if (editingAppointment is null)
        {
            return;
        }

        validationErrors = new List<string>();
        if (editingAppointment.ClientId == 0)
        {
            validationErrors.Add("Client is required.");
        }
        if (editingAppointment.ServiceId == 0)
        {
            validationErrors.Add("Service is required.");
        }
        if (editingAppointment.EndTime <= editingAppointment.StartTime)
        {
            validationErrors.Add("End time must be after start time.");
        }
        if (validationErrors.Count > 0)
        {
            return;
        }

        var providerId = editingProviderId == 0 ? (int?)null : editingProviderId;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var previousProviderId = (int?)null;
        DateTime? previousStart = null;
        DateTime? previousEnd = null;
        var isNewBooking = editingAppointment.Id == 0;
        if (isNewBooking)
        {
            db.Appointments.Add(new Appointment
            {
                ClientId = editingAppointment.ClientId,
                ServiceId = editingAppointment.ServiceId,
                ProviderId = providerId,
                StartTime = editingAppointment.StartTime,
                EndTime = editingAppointment.EndTime,
            });
            statusMessage = "Booking created.";
        }
        else
        {
            var dbAppt = await db.Appointments.FindAsync(editingAppointment.Id);
            if (dbAppt is not null)
            {
                previousProviderId = dbAppt.ProviderId;
                previousStart = dbAppt.StartTime;
                previousEnd = dbAppt.EndTime;
                dbAppt.ClientId = editingAppointment.ClientId;
                dbAppt.ServiceId = editingAppointment.ServiceId;
                dbAppt.ProviderId = providerId;
                if (dbAppt.StartTime != editingAppointment.StartTime || dbAppt.EndTime != editingAppointment.EndTime)
                {
                    dbAppt.WasRescheduled = true;
                }
                dbAppt.StartTime = editingAppointment.StartTime;
                dbAppt.EndTime = editingAppointment.EndTime;
                statusMessage = "Booking updated.";
            }
        }

        await db.SaveChangesAsync();

        // Keep every provider touched by this save in the loop: a newly (or
        // re-)assigned provider gets an "assigned" email, and a provider
        // removed from the booking (reassigned away, or unassigned
        // entirely) gets a "no longer assigned" email.
        if (providerId is not null && providerId != previousProviderId)
        {
            await NotifyProviderAsync(providerId.Value, editingAppointment.ClientId, editingAppointment.ServiceId, editingAppointment.StartTime, editingAppointment.EndTime, isNewBooking ? "assigned" : "reassigned");
        }

        if (previousProviderId is not null && previousProviderId != providerId)
        {
            await NotifyProviderAsync(previousProviderId.Value, editingAppointment.ClientId, editingAppointment.ServiceId, editingAppointment.StartTime, editingAppointment.EndTime, "removed");
        }

        // A date/time change (as opposed to just a provider reassignment) is
        // the actual "reschedule" case FSW-16 cares about - notify both the
        // client and the still-assigned provider, admin-framed (no admin
        // identity in the email body/sender - see AppointmentNotificationService).
        if (!isNewBooking && previousStart is not null && previousEnd is not null &&
            (previousStart != editingAppointment.StartTime || previousEnd != editingAppointment.EndTime))
        {
            var client = clients.FirstOrDefault(c => c.Id == editingAppointment.ClientId);
            var provider = providerId is not null ? providers.FirstOrDefault(p => p.Id == providerId) : null;
            var service = services.FirstOrDefault(s => s.Id == editingAppointment.ServiceId);
            await NotificationService.NotifyRescheduledAsync(client, provider, service, previousStart.Value, previousEnd.Value, editingAppointment.StartTime, editingAppointment.EndTime, ChangeActor.Admin);
        }

        editingAppointment = null;
        await LoadWeekAsync();
    }

    private async Task NotifyProviderAsync(int providerId, int clientId, int serviceId, DateTime start, DateTime end, string reason)
    {
        var provider = providers.FirstOrDefault(p => p.Id == providerId);
        var client = clients.FirstOrDefault(c => c.Id == clientId);
        var service = services.FirstOrDefault(s => s.Id == serviceId);
        if (provider is null)
        {
            return;
        }

        var serviceName = service?.Name ?? "a treatment";
        var clientName = client?.FullName ?? "a client";
        var when = $"{start:dddd, MMMM d} from {start:h:mm tt} to {end:h:mm tt}";

        var (subject, bodyIntro) = reason switch
        {
            "assigned" => ("New appointment assigned to you", $"You've been assigned a new appointment: <strong>{serviceName}</strong> with {clientName} on {when}."),
            "reassigned" => ("Appointment assigned to you", $"You've been assigned an appointment: <strong>{serviceName}</strong> with {clientName} on {when}."),
            "updated" => ("Your appointment was updated", $"An appointment you're assigned to was updated: <strong>{serviceName}</strong> with {clientName} is now on {when}."),
            "removed" => ("You've been removed from an appointment", $"You're no longer assigned to the <strong>{serviceName}</strong> appointment with {clientName} that was scheduled for {when}."),
            "cancelled" => ("An appointment was cancelled", $"Your <strong>{serviceName}</strong> appointment with {clientName} on {when} has been cancelled."),
            _ => ("Appointment update", $"There's an update to your <strong>{serviceName}</strong> appointment with {clientName} on {when}."),
        };

        var providerDashboardUrl = new Uri(new Uri(NavigationManager.BaseUri), "/admin/dashboard");
        await EmailSender.SendAsync(
            provider.Email,
            $"{subject} - Fargo Spa and Wellness",
            $"<p>Hi {provider.FirstName},</p><p>{bodyIntro}</p>" +
            $"<p>View your schedule here: <a href=\"{providerDashboardUrl}\">{providerDashboardUrl}</a></p>");
    }

    private async Task ConfirmAndCancelBookingAsync()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Cancel this booking? This can't be undone.");
        if (confirmed)
        {
            await CancelBookingAsync();
        }
    }

    private async Task CancelBookingAsync()
    {
        if (editingAppointment is null || editingAppointment.Id == 0)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Provider)
            .Include(a => a.Service)
            .FirstOrDefaultAsync(a => a.Id == editingAppointment.Id);

        if (dbAppt is not null)
        {
            var cancelledClient = dbAppt.Client;
            var cancelledProvider = dbAppt.Provider;
            var cancelledService = dbAppt.Service;
            var cancelledStart = dbAppt.StartTime;
            var cancelledEnd = dbAppt.EndTime;

            var refunded = false;
            if (dbAppt.PaymentStatus == "Paid" && !string.IsNullOrEmpty(dbAppt.StripePaymentIntentId))
            {
                try
                {
                    await StripeCheckout.CreateRefundAsync(dbAppt.StripePaymentIntentId);
                    refunded = true;
                    dbAppt.PaymentStatus = "Refunded";
                }
                catch (Stripe.StripeException)
                {
                    statusMessage = "Booking cancelled, but the refund failed - please refund manually in the Stripe Dashboard.";
                }
            }

            dbAppt.AppointmentStatus = "Cancelled";
            await db.SaveChangesAsync();
            statusMessage ??= refunded ? "Booking cancelled and payment refunded." : "Booking cancelled.";

            await NotificationService.NotifyCancelledAsync(cancelledClient, cancelledProvider, cancelledService, cancelledStart, cancelledEnd, ChangeActor.Admin, refunded);
        }

        editingAppointment = null;
        await LoadWeekAsync();
    }

    private async Task MarkOutcomeAsync(Appointment appt, string outcome)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments.FirstOrDefaultAsync(a => a.Id == appt.Id);
        if (dbAppt is null)
        {
            return;
        }

        dbAppt.AppointmentStatus = outcome;
        await db.SaveChangesAsync();

        statusMessage = outcome == "Completed" ? "Marked as completed." : "Marked as no-show.";
        editingAppointment = null;
        await LoadWeekAsync();
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Completed" => "completed",
        "NoShow" => "noshow",
        _ => "pending",
    };

    private static string PaymentBadgeClass(string paymentStatus) => paymentStatus switch
    {
        "Paid" => "completed",
        "Refunded" => "noshow",
        _ => "pending",
    };

    // For bookings an admin created directly (e.g. a walk-in), rather than
    // through the client Stripe checkout - there's no Stripe charge behind
    // these, so this just records that payment was collected some other way
    // (cash, card reader, etc.) so it correctly counts toward revenue.
    private async Task MarkPaidAsync()
    {
        if (editingAppointment is null || editingAppointment.Id == 0)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments.FirstOrDefaultAsync(a => a.Id == editingAppointment.Id);
        if (dbAppt is null)
        {
            return;
        }

        dbAppt.PaymentStatus = "Paid";
        await db.SaveChangesAsync();

        editingAppointment.PaymentStatus = "Paid";
        statusMessage = "Marked as paid.";
    }
}
