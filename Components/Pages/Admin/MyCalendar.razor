@page "/admin/my-calendar"
@layout ProviderLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Provider")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AppointmentNotificationService NotificationService
@inject StripeCheckoutService StripeCheckout
@inject IJSRuntime JsRuntime

<PageTitle>My Calendar - Fargo Spa and Wellness</PageTitle>

<div class="admin-page-header">
    <h1>My Calendar</h1>
    <p>Your appointments for the week.</p>
</div>

@if (appointments is null)
{
    <p>Loading...</p>
}
else
{
    <div class="calendar-toolbar">
        <div class="calendar-week-nav">
            <button type="button" class="calendar-nav-btn" @onclick="GoToPreviousWeek">&larr;</button>
            <span class="calendar-week-label">@WeekLabel</span>
            <button type="button" class="calendar-nav-btn" @onclick="GoToNextWeek">&rarr;</button>
            <button type="button" class="btn btn-spa-secondary btn-sm" @onclick="GoToToday">Today</button>
        </div>
    </div>

    @if (conflictCount > 0)
    {
        <div class="calendar-conflict-banner">
            You have @conflictCount overlapping booking@(conflictCount == 1 ? "" : "s") this week - contact an admin to resolve.
        </div>
    }

    @if (statusMessage is not null)
    {
        <div class="admin-alert">@statusMessage</div>
    }

    <div class="calendar-grid-wrap">
        <div class="calendar-grid">
            <div class="calendar-time-header"></div>
            @foreach (var day in WeekDays)
            {
                <div class="calendar-day-header @(day.Date == ClinicClock.Today ? "today" : "")">@day.ToString("ddd M/d")</div>
            }

            <div class="calendar-time-col">
                @for (var hour = StartHour; hour < EndHour; hour++)
                {
                    <div class="calendar-time-label">@(new DateTime(1, 1, 1, hour, 0, 0).ToString("h tt"))</div>
                }
            </div>

            @foreach (var day in WeekDays)
            {
                <div class="calendar-day-body" style="height:@((EndHour - StartHour) * PxPerHour)px">
                    @foreach (var appt in appointments.Where(a => a.StartTime.Date == day.Date))
                    {
                        <div class="calendar-appt-block @(conflictIds.Contains(appt.Id) ? "conflict" : "")"
                             title="@BlockTooltip(appt)"
                             style="top:@(BlockTop(appt))px; height:@(BlockHeight(appt))px">
                            <span class="calendar-appt-time">@appt.StartTime.ToString("h:mmtt")</span>
                            <span>@(appt.Client?.FullName ?? "Unknown client")</span>
                            @if (appt.StartTime > ClinicClock.Now && appt.AppointmentStatus != "Cancelled")
                            {
                                <div class="calendar-appt-actions">
                                    <a href="/reschedule/@appt.Id" class="calendar-appt-action-link" @onclick:stopPropagation="true">Reschedule</a>
                                    <button type="button" class="calendar-appt-action-link cancel" @onclick="() => ConfirmAndCancelAsync(appt)" @onclick:stopPropagation="true">Cancel</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private const int StartHour = 8;
    private const int EndHour = 19;
    private const int PxPerHour = 60;

    private int providerId;
    private DateTime weekStart = StartOfWeek(ClinicClock.Today);
    private List<Appointment>? appointments;
    private HashSet<int> conflictIds = new();
    private int conflictCount;
    private string? statusMessage;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IEnumerable<DateTime> WeekDays => Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i));
    private string WeekLabel => $"{weekStart.ToString("MMMM yyyy")} - Week of {weekStart.ToString("MMM d")}";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out providerId))
        {
            return;
        }

        await LoadWeekAsync();
    }

    private async Task LoadWeekAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var weekEnd = weekStart.AddDays(7);

        appointments = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Service)
            .Where(a => a.ProviderId == providerId && a.AppointmentStatus != "Cancelled" && a.StartTime >= weekStart && a.StartTime < weekEnd)
            .OrderBy(a => a.StartTime)
            .ToListAsync();

        // Same overlap check as Master Calendar, simplified since everything
        // here already belongs to one provider - no grouping needed.
        conflictIds = new HashSet<int>();
        for (var i = 0; i < appointments.Count; i++)
        {
            for (var j = i + 1; j < appointments.Count; j++)
            {
                if (appointments[i].StartTime < appointments[j].EndTime && appointments[j].StartTime < appointments[i].EndTime)
                {
                    conflictIds.Add(appointments[i].Id);
                    conflictIds.Add(appointments[j].Id);
                }
            }
        }
        conflictCount = conflictIds.Count;
    }

    private async Task GoToPreviousWeek()
    {
        weekStart = weekStart.AddDays(-7);
        await LoadWeekAsync();
    }

    private async Task GoToNextWeek()
    {
        weekStart = weekStart.AddDays(7);
        await LoadWeekAsync();
    }

    private async Task GoToToday()
    {
        weekStart = StartOfWeek(ClinicClock.Today);
        await LoadWeekAsync();
    }

    private static DateTime StartOfWeek(DateTime date) => date.Date.AddDays(-(int)date.DayOfWeek);

    private double BlockTop(Appointment appt)
    {
        var minutesFromStart = (appt.StartTime.Hour - StartHour) * 60 + appt.StartTime.Minute;
        return Math.Max(0, minutesFromStart / 60.0 * PxPerHour);
    }

    private double BlockHeight(Appointment appt)
    {
        var durationMinutes = Math.Max((appt.EndTime - appt.StartTime).TotalMinutes, 15);
        return durationMinutes / 60.0 * PxPerHour;
    }

    private static string BlockTooltip(Appointment appt) =>
        $"{appt.StartTime:h:mm tt}-{appt.EndTime:h:mm tt}: {appt.Client?.FullName} - {appt.Service?.Name}";

    private async Task ConfirmAndCancelAsync(Appointment appt)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Cancel this appointment? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Provider)
            .Include(a => a.Service)
            .FirstOrDefaultAsync(a => a.Id == appt.Id);

        if (dbAppt is null)
        {
            return;
        }

        var refunded = false;
        if (dbAppt.PaymentStatus == "Paid" && !string.IsNullOrEmpty(dbAppt.StripePaymentIntentId))
        {
            try
            {
                await StripeCheckout.CreateRefundAsync(dbAppt.StripePaymentIntentId);
                refunded = true;
                dbAppt.PaymentStatus = "Refunded";
            }
            catch (Stripe.StripeException)
            {
                statusMessage = "Appointment cancelled, but the automatic refund failed - please ask an admin to refund this client manually.";
            }
        }
        else if (dbAppt.PaymentStatus == "Paid")
        {
            // Paid but no Stripe payment intent means this was marked paid
            // by an admin outside Stripe (cash/card reader) - there's no
            // Stripe charge to auto-refund, so flag it instead of silently
            // doing nothing.
            statusMessage = "Appointment cancelled. This was marked paid outside Stripe - please ask an admin to refund the client directly if needed.";
        }

        dbAppt.AppointmentStatus = "Cancelled";
        await db.SaveChangesAsync();

        await NotificationService.NotifyCancelledAsync(dbAppt.Client, dbAppt.Provider, dbAppt.Service, dbAppt.StartTime, dbAppt.EndTime, ChangeActor.Provider, refunded);

        if (refunded)
        {
            await NotificationService.NotifyRefundIssuedAsync(dbAppt.Client, dbAppt.Provider, dbAppt.Service, dbAppt.StartTime, dbAppt.Service?.Price ?? 0m, "Provider cancelled the appointment.");
        }

        statusMessage ??= refunded ? "Appointment cancelled and payment refunded." : "Appointment cancelled.";
        await LoadWeekAsync();
    }
}
