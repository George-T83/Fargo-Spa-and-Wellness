@page "/admin/dashboard"
@layout ProviderLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Provider")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AppointmentNotificationService NotificationService
@inject IJSRuntime JsRuntime

<PageTitle>My Dashboard - Fargo Spa and Wellness</PageTitle>

<div class="admin-page-header">
    <h1>My Dashboard</h1>
    <p>Your appointments and daily schedule.</p>
</div>

@if (!isAvailableToday.HasValue)
{
    <p>Loading...</p>
}
else
{
    <div class="admin-quick-card mb-4">
        <h3>Today's Availability</h3>
        <p>
            Status:
            <strong>@(isAvailableToday.Value ? "Available" : "Unavailable")</strong>
        </p>
        <button type="button" class="btn btn-spa-primary" @onclick="ToggleAvailabilityAsync">
            @(isAvailableToday.Value ? "Mark unavailable" : "Mark available")
        </button>
    </div>
}

@if (appointments is null)
{
    <p>Loading...</p>
}
else
{
    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-value">@todayCount</div>
            <div class="admin-stat-label">Today</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-value">@upcomingCount</div>
            <div class="admin-stat-label">Upcoming</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-value">@completedCount</div>
            <div class="admin-stat-label">Completed</div>
        </div>
    </div>

    @if (statusMessage is not null)
    {
        <div class="admin-alert">@statusMessage</div>
    }

    @if (appointments.Count == 0)
    {
        <div class="admin-coming-soon">
            <p>No appointments assigned to you yet.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Service</th>
                        <th>Date &amp; Time</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in appointments)
                    {
                        <tr>
                            <td>@a.Client?.FullName</td>
                            <td>@a.Service?.Name</td>
                            <td>@a.StartTime.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>
                                @if (a.StartTime > ClinicClock.Now)
                                {
                                    <a href="/reschedule/@a.Id" class="btn btn-spa-secondary btn-sm">Reschedule</a>
                                    <button type="button" class="btn-reject btn-sm" @onclick="() => ConfirmAndCancelAsync(a)">Cancel</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int providerId;
    private List<Appointment>? appointments;
    private int todayCount;
    private int upcomingCount;
    private int completedCount;
    private bool? isAvailableToday;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out providerId))
        {
            return;
        }

        await LoadAppointmentsAsync();

        await using var db = await DbContextFactory.CreateDbContextAsync();

        // No row for today means available by default - see ProviderAvailability.cs.
        var todayRow = await db.ProviderAvailability
            .FirstOrDefaultAsync(pa => pa.ProviderId == providerId && pa.Date == ClinicClock.Today);
        isAvailableToday = todayRow?.IsAvailable ?? true;
    }

    private async Task LoadAppointmentsAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        appointments = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Service)
            .Where(a => a.ProviderId == providerId)
            .OrderBy(a => a.StartTime)
            .ToListAsync();

        // There is no separate appointment status field, so state is derived
        // from StartTime/EndTime against "now". An appointment can count as
        // both "today" and "upcoming" if it's later today.
        todayCount = appointments.Count(a => a.StartTime.Date == ClinicClock.Today);
        upcomingCount = appointments.Count(a => a.StartTime > ClinicClock.Now);
        completedCount = appointments.Count(a => a.EndTime < ClinicClock.Now);
    }

    private async Task ConfirmAndCancelAsync(Appointment appt)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Cancel this appointment? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Provider)
            .Include(a => a.Service)
            .FirstOrDefaultAsync(a => a.Id == appt.Id);

        if (dbAppt is null)
        {
            return;
        }

        db.Appointments.Remove(dbAppt);
        await db.SaveChangesAsync();

        await NotificationService.NotifyCancelledAsync(dbAppt.Client, dbAppt.Provider, dbAppt.Service, dbAppt.StartTime, dbAppt.EndTime, ChangeActor.Provider);

        statusMessage = "Appointment cancelled.";
        await LoadAppointmentsAsync();
    }

    private async Task ToggleAvailabilityAsync()
    {
        if (isAvailableToday is null)
        {
            return;
        }

        var newValue = !isAvailableToday.Value;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var todayRow = await db.ProviderAvailability
            .FirstOrDefaultAsync(pa => pa.ProviderId == providerId && pa.Date == ClinicClock.Today);

        if (todayRow is null)
        {
            db.ProviderAvailability.Add(new ProviderAvailability
            {
                ProviderId = providerId,
                Date = ClinicClock.Today,
                IsAvailable = newValue,
            });
        }
        else
        {
            todayRow.IsAvailable = newValue;
        }

        await db.SaveChangesAsync();
        isAvailableToday = newValue;
    }
}
