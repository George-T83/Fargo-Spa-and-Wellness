@page "/admin/availability"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Provider,Admin")]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>@(isAdmin ? "Staff Availability" : "My Availability") - Fargo Spa and Wellness</PageTitle>

@* This page serves both Admins (managing any provider) and Providers
   (managing their own hours) from one component, so the layout has to
   follow whichever role is actually viewing rather than being pinned to
   one - a provider clicking through their own portal should never get
   dropped into the Admin-branded sidebar mid-navigation. *@
<LayoutView Layout="@(roleResolved ? (isAdmin ? typeof(AdminLayout) : typeof(ProviderLayout)) : typeof(ProviderLayout))">

<div class="admin-page-header">
    <h1>@(isAdmin ? "Staff Availability" : "My Availability")</h1>
    <p>@(isAdmin ? "View and edit any provider's weekly working hours." : "Set your weekly working hours.")</p>
</div>

@if (isAdmin)
{
    @if (providers is null)
    {
        <p>Loading...</p>
    }
    else if (providers.Count == 0)
    {
        <div class="admin-coming-soon">
            <p>No providers yet. Assign the Provider role to a user on the User Roles page first.</p>
        </div>
    }
    else
    {
        <select class="admin-role-select mb-3" value="@selectedProviderId" @onchange="OnProviderSelected">
            <option value="0" disabled>Select a provider...</option>
            @foreach (var provider in providers)
            {
                <option value="@provider.Id">@provider.FullName</option>
            }
        </select>
    }
}

@if (shiftsByDay is not null)
{
    @if (validationErrors.Count > 0)
    {
        <div class="admin-alert">
            @foreach (var error in validationErrors)
            {
                <div>@error</div>
            }
        </div>
    }
    else if (statusMessage is not null)
    {
        <div class="admin-alert">@statusMessage</div>
    }

    <p class="admin-availability-hint">Add more than one shift on a day to block out a lunch break or split shift.</p>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Shifts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in DaysOfWeek)
                {
                    <tr @key="day">
                        <td class="shift-day-cell">@day</td>
                        <td>
                            @if (shiftsByDay[day].Count == 0)
                            {
                                <span class="shift-not-scheduled">Not scheduled</span>
                            }
                            else
                            {
                                @foreach (var block in shiftsByDay[day])
                                {
                                    <div class="shift-block-row" @key="block">
                                        <input type="time" class="admin-role-select"
                                               value="@block.StartTime.ToString(@"hh\:mm")"
                                               @onchange="e => block.StartTime = TimeSpan.TryParse(e.Value?.ToString(), out var t) ? t : block.StartTime" />
                                        <span class="shift-block-sep">to</span>
                                        <input type="time" class="admin-role-select"
                                               value="@block.EndTime.ToString(@"hh\:mm")"
                                               @onchange="e => block.EndTime = TimeSpan.TryParse(e.Value?.ToString(), out var t) ? t : block.EndTime" />
                                        <button type="button" class="shift-remove-btn" title="Remove shift" @onclick="() => RemoveShift(day, block)">&times;</button>
                                    </div>
                                }
                            }
                        </td>
                        <td class="shift-add-cell">
                            <button type="button" class="btn btn-spa-secondary btn-sm" @onclick="() => AddShift(day)">+ Add shift</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="button" class="btn btn-spa-primary mt-3" @onclick="SaveAsync">Save Availability</button>

    <div class="admin-timeoff-section">
        <h2 class="admin-timeoff-title">Time off</h2>
        <p class="admin-availability-hint">Block out a vacation, sick day, or any stretch of days - clients won't be able to book @(isAdmin ? "this provider" : "you") during this range, even on days that are normally scheduled.</p>

        @if (timeOffError is not null)
        {
            <div class="admin-alert">@timeOffError</div>
        }

        <div class="admin-timeoff-form">
            <div class="admin-form-field">
                <label>From</label>
                <input type="date" class="admin-role-select" @bind="timeOffStart" />
            </div>
            <div class="admin-form-field">
                <label>To</label>
                <input type="date" class="admin-role-select" @bind="timeOffEnd" />
            </div>
            <button type="button" class="btn btn-spa-secondary" @onclick="AddTimeOffAsync">+ Mark unavailable</button>
        </div>

        @if (timeOffRanges is null)
        {
            <p class="admin-availability-hint">Loading...</p>
        }
        else if (timeOffRanges.Count == 0)
        {
            <p class="shift-not-scheduled">No time off scheduled.</p>
        }
        else
        {
            <ul class="admin-timeoff-list">
                @foreach (var range in timeOffRanges)
                {
                    <li @key="range.Start">
                        <span>@FormatRange(range)</span>
                        <button type="button" class="shift-remove-btn" title="Remove" @onclick="() => RemoveTimeOffAsync(range)">&times;</button>
                    </li>
                }
            </ul>
        }
    </div>
}
else if (isAdmin && providers is not null && providers.Count > 0)
{
    <p>Select a provider above to view their schedule.</p>
}

</LayoutView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly DayOfWeek[] DaysOfWeek =
    {
        DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday,
    };

    private bool isAdmin;
    private bool roleResolved;
    private int viewerId;
    private int selectedProviderId;
    private List<User>? providers;
    private Dictionary<DayOfWeek, List<ShiftBlock>>? shiftsByDay;
    private string? statusMessage;
    private List<string> validationErrors = new();

    private List<DateRange>? timeOffRanges;
    private DateTime timeOffStart = ClinicClock.Today;
    private DateTime timeOffEnd = ClinicClock.Today;
    private string? timeOffError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out viewerId))
        {
            return;
        }

        isAdmin = authState.User.IsInRole("Admin");
        roleResolved = true;

        if (isAdmin)
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            providers = await db.Users
                .Where(u => u.Role == "Provider")
                .OrderBy(u => u.LastName)
                .ToListAsync();
        }
        else
        {
            selectedProviderId = viewerId;
            await LoadShiftsAsync();
            await LoadTimeOffAsync();
        }
    }

    private async Task OnProviderSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newProviderId) && newProviderId != 0)
        {
            selectedProviderId = newProviderId;
            statusMessage = null;
            validationErrors.Clear();
            timeOffError = null;
            await LoadShiftsAsync();
            await LoadTimeOffAsync();
        }
    }

    private async Task LoadShiftsAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var existing = await db.ProviderShifts
            .Where(s => s.ProviderId == selectedProviderId && s.IsWorking)
            .ToListAsync();

        shiftsByDay = DaysOfWeek.ToDictionary(
            day => day,
            day => existing
                .Where(s => s.DayOfWeek == day)
                .OrderBy(s => s.StartTime)
                .Select(s => new ShiftBlock { StartTime = s.StartTime, EndTime = s.EndTime })
                .ToList());
    }

    private void AddShift(DayOfWeek day)
    {
        if (shiftsByDay is null)
        {
            return;
        }

        var blocks = shiftsByDay[day];
        var defaultStart = new TimeSpan(9, 0, 0);
        var defaultEnd = new TimeSpan(17, 0, 0);

        if (blocks.Count == 0)
        {
            blocks.Add(new ShiftBlock { StartTime = defaultStart, EndTime = defaultEnd });
            return;
        }

        // Default the new block to start where the last one ends (e.g. after
        // a 9-12 morning block, the next block defaults to 12-5) so adding a
        // split shift doesn't require re-typing times that already make sense.
        var lastEnd = blocks.Max(b => b.EndTime);
        var suggestedEnd = lastEnd.Add(TimeSpan.FromHours(1));
        if (suggestedEnd > new TimeSpan(23, 59, 0))
        {
            suggestedEnd = new TimeSpan(23, 59, 0);
        }

        blocks.Add(new ShiftBlock { StartTime = lastEnd, EndTime = suggestedEnd });
    }

    private void RemoveShift(DayOfWeek day, ShiftBlock block)
    {
        shiftsByDay?[day].Remove(block);
    }

    private async Task SaveAsync()
    {
        if (shiftsByDay is null)
        {
            return;
        }

        validationErrors = new List<string>();
        foreach (var day in DaysOfWeek)
        {
            var blocks = shiftsByDay[day].OrderBy(b => b.StartTime).ToList();
            foreach (var block in blocks)
            {
                if (block.EndTime <= block.StartTime)
                {
                    validationErrors.Add($"{day}: end time must be after start time.");
                }
            }

            for (var i = 1; i < blocks.Count; i++)
            {
                if (blocks[i].StartTime < blocks[i - 1].EndTime)
                {
                    validationErrors.Add($"{day}: shifts cannot overlap.");
                }
            }
        }

        if (validationErrors.Count > 0)
        {
            return;
        }

        var rows = shiftsByDay
            .SelectMany(kv => kv.Value.Select(b => new ProviderShift
            {
                ProviderId = selectedProviderId,
                DayOfWeek = kv.Key,
                IsWorking = true,
                StartTime = b.StartTime,
                EndTime = b.EndTime,
            }))
            .ToList();

        await using var db = await DbContextFactory.CreateDbContextAsync();
        await ProviderShiftService.SaveWeeklyShifts(db, selectedProviderId, rows);

        statusMessage = isAdmin ? "That provider's availability has been saved." : "Your weekly availability has been saved.";
        await LoadShiftsAsync();
    }

    private async Task LoadTimeOffAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var blockedDates = await db.ProviderAvailability
            .Where(a => a.ProviderId == selectedProviderId && !a.IsAvailable)
            .Select(a => a.Date)
            .OrderBy(d => d)
            .ToListAsync();

        // Rows are stored one-per-date, but a multi-day range read back as
        // a wall of consecutive dates isn't useful to look at - collapse
        // runs of consecutive dates back into ranges for display.
        var ranges = new List<DateRange>();
        foreach (var date in blockedDates)
        {
            if (ranges.Count > 0 && ranges[^1].End.AddDays(1) == date)
            {
                ranges[^1] = ranges[^1] with { End = date };
            }
            else
            {
                ranges.Add(new DateRange(date, date));
            }
        }

        timeOffRanges = ranges;
    }

    private async Task AddTimeOffAsync()
    {
        timeOffError = null;

        if (timeOffEnd.Date < timeOffStart.Date)
        {
            timeOffError = "The end date must be on or after the start date.";
            return;
        }

        if ((timeOffEnd.Date - timeOffStart.Date).TotalDays > 365)
        {
            timeOffError = "That range is too long - please split it into shorter stretches.";
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();

        for (var date = timeOffStart.Date; date <= timeOffEnd.Date; date = date.AddDays(1))
        {
            var existing = await db.ProviderAvailability
                .FirstOrDefaultAsync(a => a.ProviderId == selectedProviderId && a.Date == date);

            if (existing is null)
            {
                db.ProviderAvailability.Add(new ProviderAvailability
                {
                    ProviderId = selectedProviderId,
                    Date = date,
                    IsAvailable = false,
                });
            }
            else
            {
                existing.IsAvailable = false;
            }
        }

        await db.SaveChangesAsync();
        statusMessage = isAdmin ? "That provider's time off has been saved." : "Your time off has been saved.";
        await LoadTimeOffAsync();
    }

    private async Task RemoveTimeOffAsync(DateRange range)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var rows = await db.ProviderAvailability
            .Where(a => a.ProviderId == selectedProviderId && !a.IsAvailable && a.Date >= range.Start && a.Date <= range.End)
            .ToListAsync();

        db.ProviderAvailability.RemoveRange(rows);
        await db.SaveChangesAsync();
        await LoadTimeOffAsync();
    }

    private static string FormatRange(DateRange range) =>
        range.Start == range.End
            ? range.Start.ToString("ddd, MMM d, yyyy")
            : $"{range.Start:ddd, MMM d, yyyy} - {range.End:ddd, MMM d, yyyy}";

    private record DateRange(DateTime Start, DateTime End);

    private class ShiftBlock
    {
        public TimeSpan StartTime { get; set; }
        public TimeSpan EndTime { get; set; }
    }
}
