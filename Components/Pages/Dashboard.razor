@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AppointmentNotificationService NotificationService
@inject IJSRuntime JsRuntime

<PageTitle>My Dashboard - Fargo Spa and Wellness</PageTitle>

<section class="catalog-header">
    <div class="container">
        <p class="eyebrow">Client Portal</p>
        <h1 class="section-title">@(user is null ? "Welcome" : $"Welcome, {user.FirstName}")</h1>
        <p class="catalog-subtitle">Your profile and appointment history.</p>
    </div>
</section>

<section class="services-section">
    <div class="container">
        @if (user is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="dashboard-grid">
                <div class="auth-card dashboard-profile">
                    <h2 class="booking-card-title">@user.FirstName @user.LastName</h2>
                    <p class="booking-card-subtitle">Member since @user.CreatedAt.ToString("MMMM yyyy")</p>
                    <div class="dashboard-profile-row">
                        <span class="dashboard-profile-label">Email</span>
                        <span>@user.Email</span>
                    </div>
                    <div class="dashboard-profile-row">
                        <span class="dashboard-profile-label">Phone</span>
                        <span>@FormatPhone(user.Phone)</span>
                    </div>
                    <div class="dashboard-profile-row">
                        <span class="dashboard-profile-label">Upcoming</span>
                        <span>@upcoming.Count</span>
                    </div>
                    <a href="/book" class="btn btn-spa-primary w-100 mt-3">Book a Visit</a>
                    <a href="/profile" class="btn btn-spa-secondary w-100 mt-2">Edit Profile</a>
                </div>

                <div class="dashboard-appointments">
                    <div class="auth-card">
                        <h2 class="booking-card-title">Upcoming Appointments</h2>
                        @if (statusMessage is not null)
                        {
                            <div class="alert alert-success">@statusMessage</div>
                        }
                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        @if (upcoming.Count == 0)
                        {
                            <p class="booking-card-subtitle">No upcoming appointments. <a href="/book">Book your next visit</a>.</p>
                        }
                        else
                        {
                            @foreach (var a in upcoming)
                            {
                                <div class="dashboard-appt-row">
                                    <div>
                                        <p class="dashboard-appt-service">@a.Service?.Name</p>
                                        <p class="dashboard-appt-time">@a.StartTime.ToString("dddd, MMMM d") at @a.StartTime.ToString("h:mm tt")</p>
                                        <div class="dashboard-appt-actions">
                                            <a href="@($"/reschedule/{a.Id}")" class="btn btn-spa-secondary btn-sm">Reschedule</a>
                                            <button type="button" class="btn-reject btn-sm" @onclick="() => ConfirmAndCancelAsync(a)">Cancel</button>
                                        </div>
                                        @if (a.StartTime < DateTime.Now.AddHours(24))
                                        {
                                            <p class="dashboard-appt-policy-note">Starts within 24 hours - contact us directly to change this booking.</p>
                                        }
                                    </div>
                                    <span class="dashboard-appt-price">@a.Service?.Price.ToString("C")</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="auth-card mt-3">
                        <h2 class="booking-card-title">Past Appointments</h2>
                        @if (past.Count == 0)
                        {
                            <p class="booking-card-subtitle">No past appointments yet.</p>
                        }
                        else
                        {
                            <a href="/review" class="btn btn-spa-secondary btn-sm mb-3">Leave a Review</a>
                            @foreach (var a in past)
                            {
                                <div class="dashboard-appt-row past">
                                    <div>
                                        <p class="dashboard-appt-service">@a.Service?.Name</p>
                                        <p class="dashboard-appt-time">@a.StartTime.ToString("dddd, MMMM d") at @a.StartTime.ToString("h:mm tt")</p>
                                    </div>
                                    <span class="dashboard-appt-price">@a.Service?.Price.ToString("C")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User? user;
    private List<Appointment> upcoming = new();
    private List<Appointment> past = new();
    private string? statusMessage;
    private string? errorMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out currentUserId))
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        user = await db.Users.FindAsync(currentUserId);

        var appointments = await db.Appointments
            .Include(a => a.Service)
            .Where(a => a.ClientId == currentUserId)
            .OrderBy(a => a.StartTime)
            .ToListAsync();

        upcoming = appointments.Where(a => a.StartTime >= DateTime.Now).ToList();
        past = appointments.Where(a => a.StartTime < DateTime.Now).OrderByDescending(a => a.StartTime).ToList();
    }

    private static string FormatPhone(string phone)
    {
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        if (digits.Length == 11 && digits[0] == '1')
        {
            digits = digits[1..];
        }

        return digits.Length == 10
            ? $"{digits[..3]}-{digits.Substring(3, 3)}-{digits[6..]}"
            : phone;
    }

    private async Task ConfirmAndCancelAsync(Appointment appt)
    {
        statusMessage = null;
        errorMessage = null;

        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Cancel this appointment? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Provider)
            .Include(a => a.Service)
            .FirstOrDefaultAsync(a => a.Id == appt.Id);

        if (dbAppt is null)
        {
            return;
        }

        if (dbAppt.StartTime < DateTime.Now.AddHours(24))
        {
            errorMessage = "This appointment starts in less than 24 hours and cannot be cancelled online. Please contact us directly.";
            await LoadAsync();
            return;
        }

        db.Appointments.Remove(dbAppt);
        await db.SaveChangesAsync();

        await NotificationService.NotifyCancelledAsync(dbAppt.Client, dbAppt.Provider, dbAppt.Service, dbAppt.StartTime, dbAppt.EndTime, ChangeActor.Client);

        statusMessage = "Appointment cancelled.";
        await LoadAsync();
    }
}
