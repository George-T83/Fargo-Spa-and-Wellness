@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Family_and_Spa_Wellness.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AppointmentNotificationService NotificationService
@inject StripeCheckoutService StripeCheckout
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>My Dashboard - Fargo Spa and Wellness</PageTitle>

<section class="catalog-header">
    <div class="container">
        <p class="eyebrow">Client Portal</p>
        <h1 class="section-title">@(user is null ? "Welcome" : $"Welcome, {user.FirstName}")</h1>
        <p class="catalog-subtitle">Your profile and appointment history.</p>
    </div>
</section>

<section class="services-section">
    <div class="container">
        @if (user is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="dashboard-grid">
                <div class="auth-card dashboard-profile">
                    <h2 class="booking-card-title">@user.FirstName @user.LastName</h2>
                    <p class="booking-card-subtitle">Member since @user.CreatedAt.ToString("MMMM yyyy")</p>
                    <div class="dashboard-profile-row">
                        <span class="dashboard-profile-label">Email</span>
                        <span>@user.Email</span>
                    </div>
                    <div class="dashboard-profile-row">
                        <span class="dashboard-profile-label">Phone</span>
                        <span>@FormatPhone(user.Phone)</span>
                    </div>
                    <div class="dashboard-profile-row">
                        <span class="dashboard-profile-label">Upcoming</span>
                        <span>@upcoming.Count</span>
                    </div>
                    <button type="button" class="btn btn-spa-primary w-100 mt-3" @onclick='() => NavigationManager.NavigateTo("/book")'>Book a Visit</button>
                    <button type="button" class="btn btn-spa-secondary w-100 mt-2" @onclick='() => NavigationManager.NavigateTo("/profile")'>Edit Profile</button>
                </div>

                <div class="dashboard-appointments">
                    <div class="auth-card">
                        <h2 class="booking-card-title">Upcoming Appointments</h2>
                        @if (statusMessage is not null)
                        {
                            <div class="alert alert-success">@statusMessage</div>
                        }
                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        @if (upcoming.Count == 0)
                        {
                            <p class="booking-card-subtitle">No upcoming appointments. <a href="/book">Book your next visit</a>.</p>
                        }
                        else
                        {
                            @foreach (var a in upcoming)
                            {
                                <div class="dashboard-appt-row">
                                    <div>
                                        <p class="dashboard-appt-service">@a.Service?.Name</p>
                                        <p class="dashboard-appt-time">@a.StartTime.ToString("dddd, MMMM d") at @a.StartTime.ToString("h:mm tt")</p>
                                        <div class="dashboard-appt-actions">
                                            @if (a.StartTime < ClinicClock.Now.AddHours(24))
                                            {
                                                <button type="button" class="btn btn-spa-secondary btn-sm" disabled>Reschedule</button>
                                                <button type="button" class="btn-reject btn-sm" disabled>Cancel</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-spa-secondary btn-sm" @onclick='() => NavigationManager.NavigateTo($"/reschedule/{a.Id}")'>Reschedule</button>
                                                <button type="button" class="btn-reject btn-sm" @onclick="() => ConfirmAndCancelAsync(a)">Cancel</button>
                                            }
                                        </div>
                                        @if (a.StartTime < ClinicClock.Now.AddHours(24))
                                        {
                                            <p class="dashboard-appt-policy-note">Starts within 24 hours - contact us directly to change this booking.</p>
                                        }
                                    </div>
                                    <span class="dashboard-appt-price">@a.Service?.Price.ToString("C")</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="auth-card mt-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h2 class="booking-card-title mb-0">Past Appointments</h2>
                            @if (past.Count > 0)
                            {
                                <button type="button" class="btn btn-spa-secondary btn-sm" @onclick='() => NavigationManager.NavigateTo("/review")'>Leave a Review</button>
                            }
                        </div>
                        @if (past.Count == 0)
                        {
                            <p class="booking-card-subtitle">No past appointments yet.</p>
                        }
                        else
                        {
                            @foreach (var a in past)
                            {
                                <div class="dashboard-appt-row past">
                                    <div>
                                        <p class="dashboard-appt-service">@a.Service?.Name</p>
                                        <p class="dashboard-appt-time">@a.StartTime.ToString("dddd, MMMM d") at @a.StartTime.ToString("h:mm tt")</p>
                                    </div>
                                    <span class="dashboard-appt-price">@a.Service?.Price.ToString("C")</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="auth-card mt-3">
                        <h2 class="booking-card-title">My Reviews</h2>
                        @if (myReviews.Count == 0)
                        {
                            <p class="booking-card-subtitle">You haven't left a review yet.</p>
                        }
                        else
                        {
                            @foreach (var t in myReviews)
                            {
                                <div class="dashboard-appt-row">
                                    <div>
                                        <div class="testimonial-stars">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <span class="testimonial-star @(i <= t.Rating ? "filled" : "empty")">@(i <= t.Rating ? "★" : "☆")</span>
                                            }
                                        </div>
                                        <p class="dashboard-appt-time mb-0">@t.ReviewText</p>
                                        @if (t.ApprovalStatus == "Pending")
                                        {
                                            <p class="dashboard-appt-policy-note">Pending approval</p>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User? user;
    private List<Appointment> upcoming = new();
    private List<Appointment> past = new();
    private List<Testimonial> myReviews = new();
    private string? statusMessage;
    private string? errorMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var idClaim = authState.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out currentUserId))
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        user = await db.Users.FindAsync(currentUserId);

        var appointments = await db.Appointments
            .Include(a => a.Service)
            .Where(a => a.ClientId == currentUserId && a.AppointmentStatus != "Cancelled")
            .OrderBy(a => a.StartTime)
            .ToListAsync();

        upcoming = appointments.Where(a => a.StartTime >= ClinicClock.Now).ToList();
        past = appointments.Where(a => a.StartTime < ClinicClock.Now).OrderByDescending(a => a.StartTime).ToList();

        myReviews = await db.Testimonials
            .Where(t => t.ClientId == currentUserId && t.ApprovalStatus != "Rejected")
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();
    }

    private static string FormatPhone(string phone)
    {
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        if (digits.Length == 11 && digits[0] == '1')
        {
            digits = digits[1..];
        }

        return digits.Length == 10
            ? $"({digits[..3]})-{digits.Substring(3, 3)}-{digits[6..]}"
            : phone;
    }

    private async Task ConfirmAndCancelAsync(Appointment appt)
    {
        statusMessage = null;
        errorMessage = null;

        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Cancel this appointment? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var dbAppt = await db.Appointments
            .Include(a => a.Client)
            .Include(a => a.Provider)
            .Include(a => a.Service)
            .FirstOrDefaultAsync(a => a.Id == appt.Id);

        if (dbAppt is null)
        {
            return;
        }

        if (dbAppt.StartTime < ClinicClock.Now.AddHours(24))
        {
            errorMessage = "This appointment starts in less than 24 hours and cannot be cancelled online. Please contact us directly.";
            await LoadAsync();
            return;
        }

        dbAppt.AppointmentStatus = "Cancelled";

        // Cancelling outside the 24-hour window is a free cancellation per
        // policy, so a paid appointment gets refunded automatically here
        // rather than requiring staff to notice and issue it manually.
        var wasPaid = dbAppt.PaymentStatus == "Paid";
        if (wasPaid && !string.IsNullOrEmpty(dbAppt.StripePaymentIntentId))
        {
            await StripeCheckout.CreateRefundAsync(dbAppt.StripePaymentIntentId);
            dbAppt.PaymentStatus = "Refunded";
        }

        await db.SaveChangesAsync();

        await NotificationService.NotifyCancelledAsync(dbAppt.Client, dbAppt.Provider, dbAppt.Service, dbAppt.StartTime, dbAppt.EndTime, ChangeActor.Client, refunded: wasPaid);

        if (wasPaid)
        {
            await NotificationService.NotifyRefundIssuedAsync(dbAppt.Client, dbAppt.Provider, dbAppt.Service, dbAppt.StartTime, dbAppt.Service?.Price ?? 0m, "Client cancelled more than 24 hours before the appointment.");
        }

        statusMessage = wasPaid ? "Appointment cancelled and refunded." : "Appointment cancelled.";
        await LoadAsync();
    }
}
