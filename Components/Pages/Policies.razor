@page "/policies"

<PageTitle>Booking &amp; Cancellation Policy - Fargo Spa and Wellness</PageTitle>

<section class="catalog-header">
    <div class="container">
        <p class="eyebrow">Good To Know</p>
        <h1 class="section-title">Booking &amp; Cancellation Policy</h1>
        <p class="catalog-subtitle">A few things to know before your visit.</p>
    </div>
</section>

<section class="services-section">
    <div class="container">
        <div class="auth-card policy-card">
            <div class="policy-row">
                <p class="policy-title">Cancellation &amp; Rescheduling</p>
                <p class="about-body-text">Appointments may be cancelled or rescheduled free of charge up to 24 hours before the scheduled time. Cancellations within 24 hours are subject to a 50% service charge; no-shows are charged the full service price.</p>
            </div>

            <div class="policy-row">
                <p class="policy-title">Age Policy</p>
                <p class="about-body-text">Guests must be 18 or older to register an account or book any appointment, whether for themselves or on behalf of another person. We are currently unable to accommodate guests under 18.</p>
            </div>

            <div class="policy-row">
                <p class="policy-title">Health Disclosure</p>
                <p class="about-body-text">Clients must disclose allergies, pregnancy, skin conditions, or injuries at booking or check-in so providers can adjust treatment safely.</p>
            </div>

            <div class="policy-row">
                <p class="policy-title">Late Arrivals</p>
                <p class="about-body-text">Treatments end at the originally scheduled time to avoid delaying subsequent bookings; late arrivals will not receive an extension.</p>
            </div>

            <div class="policy-row">
                <p class="policy-title">Gratuity</p>
                <p class="about-body-text">Gratuity is not included in listed prices and is left to the client's discretion.</p>
            </div>

            <div class="policy-row">
                <p class="policy-title">Payment</p>
                <p class="about-body-text">Full payment is due at the time of booking via our secure online payment gateway. Package pricing is charged as a single line item.</p>
            </div>
        </div>
    </div>
</section>
