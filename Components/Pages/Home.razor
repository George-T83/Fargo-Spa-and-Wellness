@page "/"
@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Fargo Spa and Wellness</PageTitle>

<section class="hero">
    <div class="hero-bg" style="background-image:url('https://images.pexels.com/photos/3997991/pexels-photo-3997991.jpeg?auto=compress&cs=tinysrgb&w=1600')"></div>
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8">
                <span class="hero-badge">&#127807; Now welcoming new guests</span>
                <h1 class="hero-title mt-3">Your sanctuary for<br />rest and renewal</h1>
                <p class="hero-subtitle">
                    Escape the everyday at Fargo Spa. From therapeutic massage to restorative
                    body rituals, every treatment is crafted to restore your natural balance.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="/book" class="btn btn-spa-primary btn-lg">Book Your Retreat</a>
                    <a href="/services" class="btn btn-spa-secondary btn-lg">Explore Treatments &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="services" class="services-section">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between">
            <div>
                <p class="eyebrow">Featured Treatments</p>
                <h2 class="section-title">Begin your journey</h2>
            </div>
            <a href="/services" class="view-all-link d-none d-sm-inline-flex">View all &rarr;</a>
        </div>
        <div class="row g-4 mt-2">
            <div class="col-md-6 col-lg-3">
                <a href="/services" class="service-card h-100 d-block">
                    <div class="service-icon">@Icon("Facial & Skincare")</div>
                    <p class="service-category">Facial &amp; Skincare</p>
                    <h3 class="service-name">Anti-Aging Collagen Facial</h3>
                    <p class="service-description">A collagen-boosting treatment targeting fine lines and loss of elasticity.</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="/services" class="service-card h-100 d-block">
                    <div class="service-icon">@Icon("Body Treatments")</div>
                    <p class="service-category">Body Treatments</p>
                    <h3 class="service-name">Aromatherapy Body Wrap</h3>
                    <p class="service-description">A detoxifying wrap infused with essential oils to nourish and soften the skin.</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="/services" class="service-card h-100 d-block">
                    <div class="service-icon">@Icon("Wellness & Add-Ons")</div>
                    <p class="service-category">Wellness &amp; Add-Ons</p>
                    <h3 class="service-name">Aromatherapy Enhancement</h3>
                    <p class="service-description">Add a custom essential oil blend to any massage or body treatment.</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a href="/services" class="service-card h-100 d-block">
                    <div class="service-icon">@Icon("Body Treatments")</div>
                    <p class="service-category">Body Treatments</p>
                    <h3 class="service-name">Body Polish &amp; Buff</h3>
                    <p class="service-description">A gentle, all-over exfoliating polish that leaves skin smooth, soft, and radiant.</p>
                </a>
            </div>
        </div>
    </div>
</section>

<section id="testimonials" class="testimonial-section">
    <div class="container">
        <div class="text-center mb-4">
            <p class="eyebrow">Client Stories</p>
            <h2 class="section-title">What our guests are saying</h2>
        </div>
        <TestimonialsSection />
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-card text-center">
            <div class="cta-icon">&#10024;</div>
            <h2 class="cta-title">Ready to unwind?</h2>
            <p class="cta-subtitle">
                Reserve your treatment in minutes. Choose your service, pick a time, and we'll
                take care of the rest.
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center mt-4">
                <a href="/book" class="btn btn-spa-primary btn-lg">Book a Visit</a>
                <a href="#testimonials" class="btn btn-spa-ghost btn-lg">Read Reviews</a>
            </div>
        </div>
    </div>
</section>

@code {
    // These four featured treatments are hand-authored marketing copy, not
    // pulled from the Services table - but their icons should still reflect
    // whatever an admin has configured for that category, so this looks up
    // the same ServiceCategory rows the Service Catalog page manages instead
    // of hardcoding emoji here too.
    private Dictionary<string, string> categoryIcons = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        categoryIcons = await db.ServiceCategories
            .ToDictionaryAsync(c => c.Name, c => c.Icon, StringComparer.OrdinalIgnoreCase);
    }

    private string Icon(string category) =>
        categoryIcons.GetValueOrDefault(category, ServiceCategory.DefaultIcon);
}