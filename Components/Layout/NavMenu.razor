<header class="spa-navbar">
    <div class="spa-navbar-inner">
        <NavLink class="spa-brand" href="" Match="NavLinkMatch.All">
            <span class="spa-brand-icon">
                <svg viewBox="0 0 576 512" width="20" height="20" fill="white">
                    <path d="M183.1 235.3c33.7 20.7 62.9 48.1 85.8 80.5c7 9.9 13.4 20.3 19.1 31c5.7-10.8 12.1-21.1 19.1-31c22.9-32.4 52.1-59.8 85.8-80.5C437.6 207.8 490.1 192 546 192h9.9c11.1 0 20.1 9 20.1 20.1C576 360.1 456.1 480 308.1 480H288 267.9C119.9 480 0 360.1 0 212.1C0 201 9 192 20.1 192H30c55.9 0 108.4 15.8 153.1 43.3zM301.5 37.6c15.7 16.9 61.1 71.8 84.4 164.6c-38 21.6-71.4 50.8-97.9 85.6c-26.5-34.8-59.9-63.9-97.9-85.6c23.2-92.8 68.6-147.7 84.4-164.6C278 33.9 282.9 32 288 32s10 1.9 13.5 5.6z" />
                </svg>
            </span>
            <span class="spa-brand-text">
                <span class="spa-brand-name">Fargo Spa</span>
                <span class="spa-brand-tagline">Wellness &amp; Beauty</span>
            </span>
        </NavLink>

        <input type="checkbox" id="nav-toggle" class="navbar-toggler" title="Navigation menu" />

        <div class="spa-menu">
            <nav class="spa-links">
                <NavLink class="spa-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="spa-link" href="services">Treatments</NavLink>
                <NavLink class="spa-link" href="#testimonials">Reviews</NavLink>
                <NavLink class="spa-link" href="contact">Contact</NavLink>
            </nav>

            <div class="spa-actions">
                <AuthorizeView>
                    <Authorized>
                        @if (context.User.IsInRole("Admin"))
                        {
                            <NavLink href="/admin" class="btn btn-spa-secondary btn-sm">Admin Portal</NavLink>
                        }
                        else if (context.User.IsInRole("Provider"))
                        {
                            <NavLink href="/admin/dashboard" class="btn btn-spa-secondary btn-sm">Provider Portal</NavLink>
                        }
                        else
                        {
                            <NavLink href="dashboard" class="btn btn-spa-secondary btn-sm">Client Portal</NavLink>
                        }
                        <div class="spa-account-menu">
                            <span class="spa-account-name">Hi, @FirstName(context.User.Identity?.Name)</span>
                            <form method="post" action="/account/logout">
                                <button type="submit" class="btn btn-spa-secondary btn-sm">Sign out</button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-spa-secondary btn-sm">Sign in</a>
                        <a href="/register" class="btn btn-spa-secondary btn-sm">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="/book" class="btn btn-spa-primary btn-sm">Book a Visit</a>
            </div>
        </div>

        <label for="nav-toggle" class="spa-toggle" aria-label="Toggle navigation">&#9776;</label>
    </div>
</header>

@code {
    private static string FirstName(string? fullName) =>
        string.IsNullOrWhiteSpace(fullName) ? "there" : fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
}