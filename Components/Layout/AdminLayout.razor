@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <span class="admin-brand-icon">
                <svg viewBox="0 0 576 512" width="20" height="20" fill="white">
                    <path d="M183.1 235.3c33.7 20.7 62.9 48.1 85.8 80.5c7 9.9 13.4 20.3 19.1 31c5.7-10.8 12.1-21.1 19.1-31c22.9-32.4 52.1-59.8 85.8-80.5C437.6 207.8 490.1 192 546 192h9.9c11.1 0 20.1 9 20.1 20.1C576 360.1 456.1 480 308.1 480H288 267.9C119.9 480 0 360.1 0 212.1C0 201 9 192 20.1 192H30c55.9 0 108.4 15.8 153.1 43.3zM301.5 37.6c15.7 16.9 61.1 71.8 84.4 164.6c-38 21.6-71.4 50.8-97.9 85.6c-26.5-34.8-59.9-63.9-97.9-85.6c23.2-92.8 68.6-147.7 84.4-164.6C278 33.9 282.9 32 288 32s10 1.9 13.5 5.6z" />
                </svg>
            </span>
            <span class="admin-brand-text">
                <span class="admin-brand-name">Fargo Spa</span>
                <span class="admin-brand-tagline">Admin Portal</span>
            </span>
        </div>

        <nav class="admin-nav">
            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Provider"))
                    {
                        <p class="admin-nav-heading">Staff</p>
                        <NavLink class="admin-nav-link" href="/admin/dashboard">
                            <span>My Dashboard</span>
                            <span class="admin-nav-badge staff">Staff</span>
                        </NavLink>
                        <NavLink class="admin-nav-link" href="/admin/my-calendar">
                            <span>My Calendar</span>
                            <span class="admin-nav-badge staff">Staff</span>
                        </NavLink>
                        <NavLink class="admin-nav-link" href="/admin/notes">
                            <span>Client Notes</span>
                            <span class="admin-nav-badge staff">Staff</span>
                        </NavLink>
                        <NavLink class="admin-nav-link" href="/admin/availability">
                            <span>My Availability</span>
                            <span class="admin-nav-badge staff">Staff</span>
                        </NavLink>
                    }

                    @if (context.User.IsInRole("Admin"))
                    {
                        <p class="admin-nav-heading">Overview</p>
                        <NavLink class="admin-nav-link" href="/admin" Match="NavLinkMatch.All">
                            <span>Dashboard</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>

                        <p class="admin-nav-heading">Scheduling</p>
                        <NavLink class="admin-nav-link" href="/admin/calendar">
                            <span>Master Calendar</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>
                        <NavLink class="admin-nav-link" href="/admin/availability">
                            <span>Staff Availability</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>

                        <p class="admin-nav-heading">Catalog &amp; Content</p>
                        <NavLink class="admin-nav-link" href="/admin/services">
                            <span>Service Catalog</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>
                        <NavLink class="admin-nav-link" href="/admin/testimonials">
                            <span>Testimonials</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>

                        <p class="admin-nav-heading">People</p>
                        <NavLink class="admin-nav-link" href="/admin/users">
                            <span>User Roles</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>
                        <NavLink class="admin-nav-link" href="/admin/notes">
                            <span>Client Notes</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>

                        <p class="admin-nav-heading">Insights</p>
                        <NavLink class="admin-nav-link" href="/admin/reporting">
                            <span>Reporting</span>
                            <span class="admin-nav-badge admin">Admin</span>
                        </NavLink>

                        <p class="admin-nav-heading">Account</p>
                        <NavLink class="admin-nav-link" href="/admin/profile">
                            <span>My Profile</span>
                        </NavLink>
                    }
                </Authorized>
            </AuthorizeView>
        </nav>

        <NavLink class="admin-home-link" href="/">
            &larr; Back to site
        </NavLink>

        <div class="admin-user">
            <AuthorizeView>
                <Authorized>
                    <span class="admin-user-avatar">@GetInitials(context.User.Identity?.Name)</span>
                    <span class="admin-user-info">
                        <span class="admin-user-name">@context.User.Identity?.Name</span>
                        <span class="admin-user-role">Admin &middot; Signed in</span>
                    </span>
                    <form method="post" action="/account/logout">
                        <button type="submit" class="admin-user-signout" title="Sign out">&#8677;</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <div class="admin-main">
        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
