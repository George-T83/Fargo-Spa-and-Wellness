@using Family_and_Spa_Wellness.Data
@using Family_and_Spa_Wellness.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<div class="auth-card">
    <EditForm Model="model" OnValidSubmit="HandleUpdate">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }

        <div class="auth-field">
            <label class="auth-label">First name</label>
            <InputText class="auth-input" placeholder="First Name" @bind-Value="model.FirstName" />
            <ValidationMessage For="() => model.FirstName" class="auth-error" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Last name</label>
            <InputText class="auth-input" placeholder="Last Name" @bind-Value="model.LastName" />
            <ValidationMessage For="() => model.LastName" class="auth-error" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Email address (read-only)</label>
            <div class="auth-input-wrap">
                <span class="auth-input-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 5L2 7" />
                    </svg>
                </span>
                <input type="email" class="auth-input has-icon" value="@model.Email" disabled />
            </div>
        </div>

        <div class="auth-field">
            <label class="auth-label">Phone number</label>
            <InputText class="auth-input" placeholder="Phone Number" @bind-Value="model.Phone" />
            <ValidationMessage For="() => model.Phone" class="auth-error" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Notifications</label>
            <p class="notify-pref-hint">Get emailed about booking changes (cancellations, reschedules, receipts)?</p>
            <div class="notify-pref-grid notify-pref-grid-2">
                <button type="button" class="notify-pref-option @(model.NotifyByEmail ? "selected" : "")"
                        @onclick="() => SetPreference(true)">
                    <span class="notify-pref-icon">✉️</span>
                    <span class="notify-pref-label">Email me</span>
                </button>
                <button type="button" class="notify-pref-option @(!model.NotifyByEmail ? "selected" : "")"
                        @onclick="() => SetPreference(false)">
                    <span class="notify-pref-icon">🔕</span>
                    <span class="notify-pref-label">No emails</span>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-spa-primary w-100">Save changes</button>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly ProfileModel model = new();
    private string? errorMessage;
    private string? successMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var userState = authState.User;

        if (userState.Identity?.IsAuthenticated == true)
        {
            var idClaim = userState.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idClaim, out currentUserId))
            {
                await LoadProfileAsync();
            }
        }

        var query = System.Web.HttpUtility.ParseQueryString(new Uri(NavigationManager.Uri).Query);
        if (query["updated"] == "1")
        {
            successMessage = "Profile updated successfully!";
        }
    }

    private async Task LoadProfileAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Users.FindAsync(currentUserId);
        if (user is not null)
        {
            model.FirstName = user.FirstName;
            model.LastName = user.LastName;
            model.Phone = user.Phone;
            model.Email = user.Email;
            model.NotifyByEmail = user.NotifyByEmail;
        }
    }

    private void SetPreference(bool email)
    {
        model.NotifyByEmail = email;
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;
        successMessage = null;

        if (currentUserId == 0)
        {
            errorMessage = "User session is invalid.";
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Users.FindAsync(currentUserId);
        if (user is null)
        {
            errorMessage = "Your user account could not be found.";
            return;
        }

        user.FirstName = model.FirstName.Trim();
        user.LastName = model.LastName.Trim();
        user.Phone = model.Phone;
        user.NotifyByEmail = model.NotifyByEmail;

        await db.SaveChangesAsync();

        // The nav bar's greeting comes from a claim baked into the auth
        // cookie at login - it won't reflect this name change until the
        // cookie is reissued, which Blazor Server can only do via a real
        // HTTP round-trip (not from inside the live circuit).
        var currentPath = new Uri(NavigationManager.Uri).AbsolutePath;
        var returnUrl = Uri.EscapeDataString($"{currentPath}?updated=1");
        NavigationManager.NavigateTo($"/account/refresh-claims?returnUrl={returnUrl}", forceLoad: true);
    }

    private class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First name is required")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last name is required")]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Phone number is required")]
        [System.ComponentModel.DataAnnotations.Phone(ErrorMessage = "Enter a valid phone number")]
        public string Phone { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;
        public bool NotifyByEmail { get; set; } = true;
    }
}
